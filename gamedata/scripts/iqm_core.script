-- ======================================================================
--  Immersive Quest Markers
-- ======================================================================
-- The menu, the lifecycle and the per-frame loop that drives everything else.
--
-- What was one 4,372-line file until R2.45 is now four, and the reason is the same
-- one that carved iqm_debug out at R2.44: a .script gets 198 locals, going over is a
-- SYNTAX ERROR AT LOAD, and this file had reached 187 of them -- eleven from taking
-- the cards, the markers and the route down together. The split is by QUESTION:
--
--   iqm_scan    -- WHO. NPC selection: quest targets, the guide job, recruitables,
--                  the service/VIP classifier, and the amortized scanner under them.
--                  Produces a desired set, [npc_id] = role, and knows nothing else.
--   iqm_cards   -- WHAT IT LOOKS LIKE. The IqmCards dialog, the widget pools, the
--                  card and badge layout, and the route stroke's whole renderer.
--   iqm_beacon  -- THE THROUGH-THE-WALL MARK. Which roles carry one, its glyph and
--                  tint, the candidate set, and the player's placed waypoint.
--
-- What stays here: the option table and read_config (this file owns the MCM menu and
-- is the single source of config for all of them), the reveal hotkey, the visibility
-- gates, the per-NPC card pass, and the accessors iqm_nav reads the objective through.
--
-- The rule for reaching across those boundaries is written out under THE SHARED-STATE
-- SEAM below, next to the state it governs. Read it before adding a cross-module read.

local MAX_CARDS     = 8      -- most NPCs carded at once (extras skipped; logged if debug_log)
local SCAN_INTERVAL = 2000   -- ms between task scans

-- ==========================================================================
-- THE OPTION REGISTRY (R2.46)
-- ==========================================================================
-- ONE record per option. Everything that used to be its own list is now a VIEW of
-- this one: DEFAULTS and PAGE_OF below are built from it, and iqm_mcm builds the
-- whole menu by walking it.
--
-- Adding an option used to mean editing four places that nothing checked for
-- agreement -- DEFAULTS here, PAGE_OF here, the widget row in iqm_mcm.on_mcm_load,
-- and the caption/description pair in st_mcm_iqm.xml. Only the last of those four
-- ever announces itself, and only by drawing a raw string id on screen. The other
-- three drift in silence: a key with no PAGE_OF entry reads its default for every
-- player for ever, and a menu row with no default is a control whose value nothing
-- reads. Three of the four are now one; the fourth is checked by the mcm harness,
-- which fails if a key is missing its strings in either locale.
--
-- A record carries the key, its page, its default, the widget type and whatever that
-- type needs (min/max/step/prec, or a content list), and the NAME of a precondition.
-- Preconditions are named rather than written here because every one of them reads an
-- MCM storage path, and reading storage is the menu's business -- iqm_mcm owns the
-- closures and this file only points at them.
--
-- Rows that are PURE UI carry no key and no default, so they can never reach DEFAULTS:
-- a `section` row is a caption, and a `desc` row is a note. Both still take a page, a
-- colour and a precondition, because both are things you can put in the wrong place.
--
-- ORDER IS THE MENU ORDER. iqm_mcm walks this list once and drops each row onto the
-- page it names, so a row moves in the menu by moving here.
--
-- Rows sit at column 0 rather than indented one tab, which is the only place in this
-- mod that does: this is four hundred lines of data whose rows are already at the width
-- a comment column wants, and a tab on every one of them buys nothing back.
--
-- STORAGE PATHS ARE "iqm/<page>/<key>" AND MUST NOT MOVE. Renaming a page or a key
-- orphans every setting saved under the old path, and ui_mcm.get on a path the menu no
-- longer declares returns nil AND writes an error line to the log on every call. That
-- is why the waypoint page's id is still "beacons" and the nameplate page's is still
-- "cards": those are storage, not labels. Reordering WITHIN a page is free.

-- The subpages, in menu order. One page per FEATURE (R2.24), replacing a Core/Advanced
-- split which cut every feature in half: the route's switch was on one page and its
-- colour on the other, and a minimap-only player had to work across both to configure
-- one trail. Difficulty is a SECTION within each page instead.
--
-- `banner` is the plate at the head of the page and `btext` the title MCM overlays on
-- it -- which is the tab's own label everywhere except General, where it is the mod's
-- name, because that page is the front door.
PAGES = {
	{ id = "general",   text = "ui_mcm_iqm_tab_general",   banner = "title_gen",     btext = "ui_mcm_menu_iqm" },
	{ id = "cards",     text = "ui_mcm_iqm_tab_cards",     banner = "title_cards",   btext = "ui_mcm_iqm_tab_cards" },
	{ id = "beacons",   text = "ui_mcm_iqm_tab_beacons",   banner = "title_beacons", btext = "ui_mcm_iqm_tab_beacons" },
	{ id = "worldview", text = "ui_mcm_iqm_tab_worldview", banner = "title_world",   btext = "ui_mcm_iqm_tab_worldview" },
	{ id = "minimap",   text = "ui_mcm_iqm_tab_minimap",   banner = "title_mm",      btext = "ui_mcm_iqm_tab_minimap" },
}

OPTIONS = {

-- ==========================================================================
-- General: the master switch, the hotkey, and the settings that are not any one
-- feature's -- chevron spacing (shared by both route views) and diagnostics.
-- ==========================================================================
{ key = "enabled", page = "general", def = true, type = "check" },   -- master on/off

-- ---- Reveal hotkey --------------------------------------------------------
-- Values mirror MCM's own activation modes (mcm_kb_mode_*), so the menu can use MCM's
-- labels. The feature stays opt-in through the key, not the mode: an unbound key (-1,
-- the default) means the cards are always shown whatever the mode, which is the
-- pre-hotkey behaviour.
--
-- The stock MCM trio (key_bind + kb_mod_radio modifier + activation mode), the same
-- shape Ammo Check and the rest of GAMMA use. Every VALUE label is one of MCM's own
-- string ids ("mcm_kb_mod_*" / "mcm_kb_mode_*"), so this mod ships none of them --
-- ui_mcm's Register_List falls back to "ui_mcm_lst_<value>" out of MCM's table. Only
-- the three captions are ours.
--
-- Value 3, hold-to-show, is the one exception and the one label we still ship: MCM has
-- no equivalent (its mcm_kb_mode_hold is a long press that fires once, which is value 2
-- here), and showing the cards only while the key is physically down is a distinct
-- behaviour worth keeping.
--
-- There is deliberately no "always" value: an unbound key already means always shown
-- (reveal_visible in iqm_core returns true for key < 0), so it would only duplicate
-- it. The explicit hint on the modifier row pulls MCM's caption and keeps the hint loop
-- in iqm_mcm from overwriting it. All three rows need MCM >= 1.6.0; the precondition
-- hides them on older builds (where ui_mcm.kb_mod_radio is nil anyway) in favour of the
-- note underneath -- which is why the header itself is unconditional.
{ section = "reveal", page = "general", text = "ui_mcm_iqm_hdr_reveal" },
-- DIK code of the reveal key; -1 = unbound (cards always shown)
{ key = "reveal_key",  page = "general", def = -1, type = "key_bind", pre = "has_keybinds" },
-- required modifier: 0 none, 1 shift, 2 ctrl, 3 alt
{ key = "reveal_mod",  page = "general", def = 0, type = "kb_mod", pre = "has_keybinds",
  hint = "mcm_kb_modifier", content = {
	{ 0, "mcm_kb_mod_none" },
	{ 1, "mcm_kb_mod_shift" },
	{ 2, "mcm_kb_mod_ctrl" },
	{ 3, "mcm_kb_mod_alt" },
}},
-- 0 press to toggle, 1 double-tap to toggle, 2 long-press to toggle, 3 hold to show
{ key = "reveal_mode", page = "general", def = 0, type = "list", pre = "has_keybinds",
  content = {
	{ 0, "mcm_kb_mode_press" },
	{ 1, "mcm_kb_mode_dtap" },
	{ 2, "mcm_kb_mode_hold" },
	{ 3, "iqm_reveal_hold" },
}},
{ id = "reveal_no_mcm", page = "general", type = "desc",
  text = "ui_mcm_iqm_reveal_no_mcm", clr = "note", pre = "no_keybinds" },

-- ---- Combat dim -----------------------------------------------------------
-- Fade the overlays DOWN TO A FLOOR -- never away -- while the weapon is up and busy:
-- aiming, firing, being shot at, reloading, clearing a jam.
--
-- WHY IT EXISTS. Cards and markers are CUIStatics, and every CUIStatic is drawn in
-- CHUDManager::RenderUI, after the whole scene and after post-process. The HUD weapon is
-- scene geometry drawn well before that (r_dsgraph_render_hud, then g_hud->Render_Last),
-- so a marker is ALWAYS on top of the gun -- there is no depth test to lose, no stencil
-- and nothing exposed to Lua that would let a UI element sample scene depth. Short of
-- moving the marks into the scene layer (which the route can do, as decals, and a
-- through-wall chevron by definition cannot) the overlap is structural. So this does not
-- remove it; it takes the overlays out of the way at the moments the overlap actually
-- costs something, which is the moments you are looking down the barrel.
--
-- A FLOOR AND NOT A HIDE, which is the whole design. Nothing crosses a visibility
-- threshold, so nothing pops, nothing re-enters, and a card you are mid-way through
-- reading when a fight starts is still readable. It also means the ADS trigger can be
-- unconditional: glassing a stalker through a scope quietens the card rather than taking
-- it away, so the "you want to read a label at exactly this moment" carve-out in
-- hud_is_shown does not have to be argued about twice.
--
-- ONE HOLD SHARED BY EVERY EVENT TRIGGER, and 0 turns the feature off, which is why
-- there is no separate switch. Aiming is the one trigger that is a STATE rather than an
-- event and so does not use the hold at all: it releases the moment the sights come
-- down, because a hold there reads as the menu lagging rather than as a decision.
{ section = "combat_dim", page = "general", text = "ui_mcm_iqm_hdr_dim" },
-- Tenths of a second the dim lasts after a shot / hit / reload / jam. Tenths for the
-- same reason route_flow is: MCM tracks are integers and 0.1 s is finer than anyone can
-- see. 0 = OFF, the whole feature.
{ key = "dim_hold", page = "general", def = 15, type = "track",
  min = 0, max = 50, step = 5 },
-- The opacity floor, as a PERCENT of what the overlay would otherwise draw at. 0 is a
-- full hide, and is deliberately reachable -- some players will want it -- but it is not
-- the default, because the default should be the behaviour that cannot flicker.
--
-- 35 is a STARTING number and expects to be raised. Alpha here is already two or three
-- multipliers deep (the distance fade, the card/marker handover, then this), and R2.26
-- is the standing lesson about what that compounding does: a flat 16% off the top left a
-- near route mark at a quarter strength and the effect could not be seen at all. Judge
-- it against a sunlit wall, not on paper.
{ key = "dim_level", page = "general", def = 35, type = "track",
  min = 0, max = 100, step = 5 },
-- Which overlays it applies to. Two checks rather than a list because they are not
-- mutually exclusive. The route is deliberately absent: it is painted on the ground
-- ahead of you, not floating over the sights, so it is not what the weapon overlaps.
{ key = "dim_cards",   page = "general", def = true, type = "check" },
{ key = "dim_beacons", page = "general", def = true, type = "check" },

-- ---- Interference ---------------------------------------------------------
-- What the overlay does during an emission and inside a psi zone: the marks tear
-- sideways, their ink separates into a coloured fringe, the range readout starts
-- printing the wrong digit, and at the worst of it the whole thing drops out. The
-- envelope behind it is iqm_noise; see that file's header for what drives it.
--
-- ON THE GENERAL PAGE because it is not any one feature's -- it reaches the nameplates,
-- the markers and the ground route together, which is exactly what this page is for.
-- And ON BY DEFAULT: the feature is characterisation rather than decoration, and a mod
-- whose whole argument is that the overlay is a rendered thing in the world should
-- behave that way out of the box. It is also the SAFE default, because the tier that can
-- take a mark away is a separate switch and that one is off (see noise_giveup).
-- rationale: docs/decisions.md#noise
{ section = "noise", page = "general", text = "ui_mcm_iqm_hdr_noise" },
{ key = "noise", page = "general", def = true, type = "check" },
-- How hard it pushes, as a percent. Scales the AMPLITUDES -- the tear, the fringe -- and
-- deliberately not the thresholds: which effects arrive in which order is the design (see
-- the tier constants in iqm_noise), and a setting that moved the thresholds would let a
-- player reorder them into something that no longer reads as degradation. Turning this
-- down makes a heavy emission look like a light one, which is the axis worth having.
--
-- 100 rather than a cautious 60, on the R2.26 lesson dim_level restates: the amplitudes
-- are already sized against the engine's whole-pixel flooring, and a default that halves
-- them lands the tear back under the pixel it has to clear to be legible at all.
-- rationale: docs/decisions.md#noise_amt
{ key = "noise_amt", page = "general", def = 100, type = "track",
  min = 10, max = 200, step = 10 },
-- The last tier: at full pressure, let it stop drawing entirely.
--
-- OFF BY DEFAULT, and this is the same argument ctr_fade and dim_level have both already
-- had -- a floor and not a hide. A marker that is gone is indistinguishable from a marker
-- the mod failed to draw, and the player cannot tell an atmospheric effect from a bug in
-- the one thing they are relying on to find the objective. Off, the give-up tier fades to
-- a deep floor instead, which says the same thing and cannot be mistaken for a fault.
-- rationale: docs/decisions.md#noise_giveup
{ key = "noise_giveup", page = "general", def = false, type = "check" },

-- ---- Shared route setting -------------------------------------------------
-- Chevron spacing sits here rather than on either route page because it shapes the
-- route iqm_nav PUBLISHES, and both views read that one list: the minimap trail places
-- one mark per published chevron. The two views' drawn DISTANCES are genuinely separate
-- (each page has its own), but the spacing cannot be, because publishing at the tighter
-- of two spacings would let the minimap's setting run the chevron pool out from under
-- the ground line.
--
-- Shown whenever either view is on, so a minimap-only player can still reach it.
{ section = "route_shared", page = "general", text = "ui_mcm_iqm_hdr_route_shared" },
-- Metres between direction chevrons along the route. 0 is deliberately not offered,
-- since the one thing a plain line cannot tell you is which way along it to go.
-- rationale: docs/decisions.md#route_gap
{ key = "route_gap", page = "general", def = 3, type = "track",
  min = 2, max = 30, step = 1 },
-- CONVEYOR SPEED for the route marks, in tenths of a metre per second (MCM tracks are
-- integers, and 0.1 m/s is finer than anyone can see). 0 holds them still, which is what
-- the route used to do and is still a legitimate setting -- a moving element in the corner
-- of the eye is a comfort question as much as a taste one. The DEFAULT is the cap, 40
-- (4 m/s, a fast walk), which is also where the range stops: past that the run reads as a
-- strobe rather than a direction -- the marks cross a gap quicker than the eye tracks one
-- of them.
-- rationale: docs/decisions.md#route_flow
{ key = "route_flow", page = "general", def = 40, type = "track",
  min = 0, max = 40, step = 1 },

-- ==========================================================================
-- The PDA MAP, which until R2.48 had no options at all: the higher-resolution spot
-- icons were unconditional, on the reasoning that art with no behaviour attached needs
-- no switch. Two things changed that. Some players want the pack's own look back, and
-- the task-KIND spots below are art that does carry behaviour.
--
-- This section sits on "general" rather than getting a page of its own because two rows
-- do not make a page, and because both are mod-wide statements rather than settings for
-- one feature -- which is what "general" already collects.
-- ==========================================================================
{ section = "mapicons", page = "general", text = "ui_mcm_iqm_hdr_mapicons" },
-- The mod's own map/minimap spot art, or the game's. OFF here means vanilla.
--
-- NEEDS A RESTART, and the label says so, because there is nowhere else to say it. The
-- engine parses map_spots.xml exactly once per process -- g_uiSpotXml is a static built
-- on the first map location and freed only at DLL detach (map_location.cpp:92-99,
-- xrgame_dll_detach.cpp:132) -- so the retexture happens once and there is no reparse to
-- hook. Not even returning to the main menu and loading a save re-reads it. The value is
-- read at that parse, by modxml_n_iqm_map_icons.icons_on.
-- rationale: docs/decisions.md#map_icons
{ key = "map_icons", page = "general", def = true, type = "check" },
-- Skull on a mutant hunt, red reticle on a bounty, while the job is still outstanding.
-- Live, unlike the row above -- iqm_taskspot re-reads this on its next pass and moves
-- the pins either way, which is also how switching it off puts the vanilla marker back.
-- Hidden when the row above is off: a green skull among vanilla icons is neither look.
{ key = "map_task_kinds", page = "general", def = true, type = "check" },
-- The NPC's name in the tooltip of every PDA pin the game puts on a person: the four
-- trade services, the fast-travel guide, and both important-character spots.
-- INDEPENDENT OF map_icons, unlike the row above -- which iqm_taskspot re-tests in code
-- before it will place a spot. This is the hint STRING: per-NPC state on the map
-- location itself, with nothing to do with whose art the pin is drawn in. Live either
-- way -- iqm_spothint re-stamps or reverts the pins already on the map when this
-- changes, so it needs no restart and no logic reset.
-- rationale: docs/decisions.md#map_spot_names
{ key = "map_spot_names", page = "general", def = true, type = "check" },
-- Keep the ordinary faction SQUAD DOT off your own companions, so the mark that
-- follows you around is the companion and not a stalker squad that happens to be
-- yours. INDEPENDENT OF map_icons like the row above, and for a stronger reason: it
-- is not art at all. This one removes a spot rather than redrawing or renaming one,
-- which is why it is the only row in this section that changes WHO gets a mark.
-- Live in both directions -- iqm_squadspot sweeps the companion registry when this
-- changes rather than waiting for each squad's next simulation tick.
-- rationale: docs/decisions.md#map_hide_companions
{ key = "map_hide_companions", page = "general", def = true, type = "check" },

{ section = "diag_gen", page = "general", text = "ui_mcm_iqm_hdr_adv", clr = "adv" },
{ key = "debug_log", page = "general", def = false, type = "check" },  -- write IQM diagnostic lines to the console/log

-- ==========================================================================
-- Nameplates: the cards themselves. The biggest page, because it is the biggest
-- feature. The page id stays "cards" -- it is a storage path, and renaming it
-- would move every key on this page.
-- ==========================================================================
{ section = "roles", page = "cards", text = "ui_mcm_iqm_hdr_roles" },
{ key = "mark_targets",    page = "cards", def = true,  type = "check" },  -- card the current objective NPC (turn-in / go-talk-to)
{ key = "mark_guides",     page = "cards", def = true,  type = "check" },  -- card the stalker currently looking for a guide ("Need a guide?" job)
{ key = "mark_companions", page = "cards", def = true,  type = "check" },  -- card nearby friendly stalkers you could recruit as a companion right now (the free "come with me" dialog)
{ key = "mark_hires",      page = "cards", def = true,  type = "check" },  -- card nearby neutral stalkers you could pay for escort duty right now (the paid-companion dialog)
{ key = "mark_guiders",    page = "cards", def = true,  type = "check" },  -- card guide NPCs (the fast-travel service, PDA "Guide" icon)
{ key = "mark_traders",    page = "cards", def = true,  type = "check" },  -- card service NPCs: traders / technicians / barkeeps / medics
{ key = "mark_important",  page = "cards", def = false, type = "check" },  -- card story/faction important characters (PDA "Important Character"); off by default (hubs get busy)
-- EXPERIMENTAL, off by default: card NPCs with a task to give right now ("HIRING", plus
-- the job kind when known). The one role not read from a cheap engine registry: it
-- queries the task system itself (heavy; cached + rationed in iqm_taskwork.script, but a
-- perf impact can't be ruled out on every setup)
{ key = "mark_work",       page = "cards", def = false, type = "check" },

{ section = "faction", page = "cards", text = "ui_mcm_iqm_hdr_faction" },
-- tint each card (accent/line/node/glow/header) with the NPC's faction colour instead of the gold accent
{ key = "faction_colors", page = "cards", def = true, type = "check" },
-- show the NPC's faction emblem on state cards (turn-in / guide / companion / paid escort) and hiring cards; other ambient cards keep their role glyph
{ key = "faction_icons",  page = "cards", def = true, type = "check" },

{ section = "look", page = "cards", text = "ui_mcm_iqm_hdr_look" },
-- service/important card style: 0 text card, 1 text + glyph (default), 2 icon-only chip
{ key = "role_style", page = "cards", def = 1, type = "list", content = {
	{ 0, "iqm_style_text" },
	{ 1, "iqm_style_mixed" },
	{ 2, "iqm_style_chip" },
}},
-- abbreviate a leading military rank in the NPC's name ("Senior Sergeant Ivanov" -> "Snr Sgt Ivanov")
{ key = "short_ranks", page = "cards", def = true, type = "check" },

{ section = "vis", page = "cards", text = "ui_mcm_iqm_hdr_vis" },
-- metres: card starts fading in at this range
{ key = "appear_dist", page = "cards", def = 16, type = "track", min = 2, max = 60, step = 1 },
-- hide the card when the NPC is behind cover (needs demonized_geometry_ray)
{ key = "los_check",   page = "cards", def = true, type = "check" },

-- --------------------------------------------------------------------------
-- FOCUS: card only what you are actually looking at (R2.59).
--
-- The answer for a player who finds a busy hub noisy and whose only option until now
-- was to turn roles off one at a time. A nameplate is dimmed away unless its anchor
-- sits near the crosshair, so the world stays clean until you look at someone -- the
-- same promise the distance fade and the LOS cull already make, applied to the third
-- thing a card can be: not the one you are asking about.
--
-- OFF BY DEFAULT, and it has to be: it is a different reading of what the overlay is
-- for. As shipped, a card is a standing annotation on a body; with this on it is an
-- answer to where you point. Both are defensible and only one can be the default.
--
-- WHAT THE MODE PICKS IS WHICH ROLES ARE EXEMPT, by ROLE_PRIO (see FOCUS_PRIO) rather
-- than by a list of roles -- so the tiers read as the grammar the cards already use
-- instead of as an arbitrary selection:
--   1  ambient only          -- the noun cards (services, VIP, HIRING). Every state
--                              card (objective, guide job, recruit, hire) is untouched,
--                              which is the "objectives always" line in the README.
--   2  all but the objective -- also gates the three state cards that are people you
--                              happen to walk past, leaving only the turn-in absolute.
--   3  everything            -- the objective too, for a bare screen.
-- rationale: docs/decisions.md#focus_mode
{ section = "focus", page = "cards", text = "ui_mcm_iqm_hdr_focus" },
{ key = "focus_mode", page = "cards", def = 0, type = "list", content = {
	{ 0, "iqm_focus_off" },
	{ 1, "iqm_focus_ambient" },
	{ 2, "iqm_focus_state" },
	{ 3, "iqm_focus_all" },
}},
-- The ring's radius, as a PERCENTAGE OF HALF THE SCREEN HEIGHT rather than in pixels: a
-- pixel radius is a different circle on every monitor, and this is a "how much of my view"
-- setting. Height, never width -- the 1024x768 virtual UI is stretched to the window, so
-- only the vertical axis means the same thing at every aspect (see the kx correction in
-- focus_factor).
--
-- THE SAME UNIT AS beacon_ctr one page over, and that is the point of choosing it: the two
-- are the only crosshair-radius sliders in the menu, they are read against the same
-- crosshair, and a player who has tuned one should not have to work out that the other is
-- measured against a different denominator. 50 here is the same ring as 50 there.
--
-- THESE THREE CARRY NO PRECONDITION, and that is a decision rather than an omission. They
-- rode focus_mode when the section was written, on the dim_hold pattern one page over --
-- and it is the wrong pattern for a menu you read at a glance. MCM evaluates a
-- precondition when it BUILDS the page, not while you are on it, so a row that appears
-- once its gate is satisfied does not appear until the menu is closed and reopened. The
-- player who has just switched focus on therefore sees a mode list with nothing under it
-- and no way to tell whether the feature has any settings at all. Three inert sliders are
-- cheaper to read past than a page that changes shape between visits: with the mode off
-- their values are simply never asked for (read_config leaves FOC.on false), so showing
-- them costs nothing but the rows themselves.
{ key = "focus_radius", page = "cards", def = 50, type = "track", min = 10, max = 120, step = 5 },
-- ...and how much of that radius is soft edge, as a percentage of it. 0 is a hard
-- circle (a card pops as it crosses); 100 fades from the very centre outward.
{ key = "focus_soft",  page = "cards", def = 40, type = "track", min = 0, max = 100, step = 5 },
-- How visible a card OUTSIDE the ring stays, as a percentage. 0 -- the default -- is the
-- strict reading: it is simply not there. Above 0 the feature becomes "quieten the rest"
-- rather than "hide the rest", which is a genuinely different thing to want and costs
-- one multiply to offer.
{ key = "focus_floor", page = "cards", def = 0,  type = "track", min = 0, max = 100, step = 5 },

{ section = "alert", page = "cards", text = "ui_mcm_iqm_hdr_alert" },
-- play a subtle PDA chirp when a card first comes into view
{ key = "sound_alert", page = "cards", def = true, type = "check" },

-- ---- Advanced -------------------------------------------------------------
{ section = "adv_cards", page = "cards", text = "ui_mcm_iqm_hdr_adv", clr = "adv" },

-- The accent is the cards' colour, but it also tints the beacon and the head node; it
-- is set here because the card is where you actually look at it. faction_colors above
-- overrides it per NPC. A soft desaturated gold.
--
-- EVERY COLOUR CHANNEL IS step 1 (R2.43), here and on both route pages. The ALPHA
-- tracks beside them are step 5, deliberately -- different quantity, different answer,
-- which is why they sit at a different step in the same group.
-- rationale: docs/decisions.md#colour-channel-step
{ section = "accent", page = "cards", text = "ui_mcm_iqm_hdr_accent", clr = "adv" },
{ key = "col_a", page = "cards", def = 255, type = "track", min = 0, max = 255, step = 5 },
{ key = "col_r", page = "cards", def = 224, type = "track", min = 0, max = 255, step = 1 },
{ key = "col_g", page = "cards", def = 196, type = "track", min = 0, max = 255, step = 1 },
{ key = "col_b", page = "cards", def = 122, type = "track", min = 0, max = 255, step = 1 },

{ section = "card", page = "cards", text = "ui_mcm_iqm_hdr_card", clr = "adv" },
-- px: horizontal offset from the head to the card
{ key = "card_off_x", page = "cards", def = 70,  type = "track", min = 0, max = 300, step = 5 },
-- px: how far the card floats above the head
{ key = "card_off_y", page = "cards", def = 40,  type = "track", min = 0, max = 200, step = 5 },
-- card plate opacity (0-255)
{ key = "card_a",     page = "cards", def = 185, type = "track", min = 0, max = 255, step = 5 },

{ section = "node", page = "cards", text = "ui_mcm_iqm_hdr_node", clr = "adv" },
-- draw the little dot at the head where the line starts
{ key = "show_node",  page = "cards", def = true, type = "check" },
-- gently breathe the node's glow halo to draw the eye
{ key = "node_pulse", page = "cards", def = true, type = "check" },
-- head node dot size (px) at full size (close up)
{ key = "node_size",  page = "cards", def = 7,   type = "track", min = 4,   max = 24,  step = 1 },
-- node size as a fraction of node_size at max distance (grows to 1 up close)
{ key = "node_min",   page = "cards", def = 0.5, type = "track", min = 0.2, max = 1,   step = 0.05 },
-- px: leader line thickness
{ key = "line_thick", page = "cards", def = 2,   type = "track", min = 1,   max = 6,   step = 1 },
-- leader line opacity (0-255)
{ key = "line_a",     page = "cards", def = 200, type = "track", min = 0,   max = 255, step = 5 },

{ section = "anchor", page = "cards", text = "ui_mcm_iqm_hdr_anchor", clr = "adv" },
-- metres to nudge the anchor vertically (0 = on the left-shoulder bone; - drops toward mid-torso; + raises it)
{ key = "head_lift", page = "cards", def = -0.02, type = "track", min = -1, max = 1,   step = 0.01, prec = 2 },
-- metres to nudge the anchor horizontally along the NPC's own right(+)/left(-) axis
{ key = "head_side", page = "cards", def = -0.03, type = "track", min = -1, max = 1,   step = 0.01, prec = 2 },
-- place the node on the shoulder toward the camera side so the leader line doesn't cross the body
{ key = "auto_side", page = "cards", def = true,  type = "check" },
-- metres to that shoulder (torso half-width) when auto_side is on
{ key = "side_amt",  page = "cards", def = 0.18,  type = "track", min = 0,  max = 0.5, step = 0.01, prec = 2 },

{ section = "motion", page = "cards", text = "ui_mcm_iqm_hdr_motion", clr = "adv" },
-- ease amount (framerate-independent; 1 = instant, lower = smoother)
{ key = "smoothing", page = "cards", def = 0.35, type = "track", min = 0.02, max = 1,   step = 0.01 },
-- px jump beyond which the card teleports instead of sliding
{ key = "snap_dist", page = "cards", def = 260,  type = "track", min = 50,   max = 600, step = 10 },

{ section = "fade", page = "cards", text = "ui_mcm_iqm_hdr_fade", clr = "adv" },
-- metres: card is fully solid once you're this close
{ key = "full_dist", page = "cards", def = 9,   type = "track", min = 1,  max = 60,   step = 1 },
-- ms between line-of-sight ray casts per NPC
{ key = "los_rate",  page = "cards", def = 150, type = "track", min = 50, max = 500,  step = 10 },
-- ms to keep showing after LOS is lost (anti-flicker)
{ key = "los_grace", page = "cards", def = 250, type = "track", min = 0,  max = 1000, step = 10 },

{ section = "sound", page = "cards", text = "ui_mcm_iqm_hdr_sound", clr = "adv" },
{ key = "sound_vol", page = "cards", def = 0.9, type = "track", min = 0, max = 1, step = 0.05 },  -- chirp volume (0-1)

-- Means nothing without mark_work: it rations the work detector's lookups, and with no
-- work cards there is nothing to ration. Shown anyway -- the section rode mark_work until
-- R2.59, which meant a player who had just switched work cards on found no work settings
-- until they left the menu and came back (docs/decisions.md#preconditions).
{ section = "work", page = "cards", text = "ui_mcm_iqm_hdr_work", clr = "adv" },
-- actively check unvisited NPCs for work (rationed; same effect as opening their dialog)
{ key = "work_probe", page = "cards", def = true, type = "check" },

-- ==========================================================================
-- Waypoint markers: the through-wall markers. A chevron on the current objective
-- NPC, shown exactly when the card can't do the job (out of card range, behind
-- cover, or off-screen -- see the crossover in draw_beacons). Deliberately
-- short-ranged: this is a "find them once you're near" aid, not cross-map
-- navigation, so it must not turn the Zone into a waypoint game.
--
-- The storage page keeps the "beacons" id: renaming it would orphan every saved
-- setting on the page, and ui_mcm.get on the old path errors.
--
-- Only THREE ROLES get a marker (R2.29): the hand-in target, guides, and the service
-- trades. The state roles (needs-a-guide / recruitable / for hire) are not markable.
-- Two switches here are not roles at all and answer to nothing on the cards page -- the
-- waypoint you placed, and your own companions (R2.57) -- because neither is an NPC the
-- scan has to find.
-- rationale: docs/decisions.md#which-roles-get-a-marker
-- ==========================================================================
-- ONE section for everything that isn't Advanced (R2.29).
--
-- Two rows here do nothing until their card role is being detected -- a marker for an
-- undetected role has nothing to mark -- and the section as a whole waits on mark_targets,
-- because the hand-in marker does. All of it is shown regardless: the section and the role
-- rows carried preconditions for exactly those reasons until R2.59, and the cost was a
-- page that filled in only after a trip out of the menu and back
-- (docs/decisions.md#preconditions). The two rows that are still conditional are gated on
-- the MOD being installed, not on a setting.
{ section = "beacon", page = "beacons", text = "ui_mcm_iqm_hdr_beacon" },
-- Marker on the SELECTED task's objective, through walls / off-screen. Was a marker on
-- every in-progress hand-in NPC until R2.46, which is why selecting a task on the PDA
-- changed nothing on screen; it now follows the selection and there is exactly one.
{ key = "mark_beacon", page = "beacons", def = true, type = "check" },
-- ...and the difficulty gate on it (R2.47). ON by default: only mark the selected task
-- once its objective is done and the marker has moved to whoever you report back to.
-- Off, the marker follows the objective at every stage -- which on a bounty is an exact
-- live position through a wall, i.e. the challenge handed over. Does nothing with
-- mark_beacon off, and is shown anyway (docs/decisions.md#preconditions).
-- rationale: docs/decisions.md#beacon_handin
{ key = "beacon_handin", page = "beacons", def = true, type = "check" },
-- Marker on EVERY pending hand-in in range, not only the selected one (R2.60). ON by
-- default, and it is the row that decides whether a turn-in outranks a shop on the same
-- body: with it off, `target` carries no marker and iqm_scan's want_marker hands the
-- marker down to whatever ambient role that NPC also has, so a quest giver who trades
-- draws REPORT BACK on his card and the trader glyph through the wall. Sits above the two
-- ambient rows because it is an objective and sorts ahead of them; rides beacon_dist with
-- them, unlike the selected task's mark. Full argument at br.target in iqm_beacon.
{ key = "beacon_targets", page = "beacons", def = true, type = "check" },
-- marker on guide NPCs
{ key = "beacon_guiders", page = "beacons", def = true, type = "check" },
-- marker on service NPCs (trader / technician / barkeep / medic)
{ key = "beacon_traders", page = "beacons", def = true, type = "check" },
-- Metres the ROLE markers reach (never below appear_dist) -- the hand-in row above and
-- the two ambient rows, not mark_beacon. It sits under them rather than above because
-- the SELECTED task's marker has had no range gate since R2.46, so this governs only the
-- rows it follows.
{ key = "beacon_dist", page = "beacons", def = 60, type = "track",
  min = 20, max = 200, step = 5 },
-- ...and on the waypoint the PLAYER placed (Personal Adjustable Waypoint). The one
-- marker here that is not about an NPC, and the one exempt from beacon_dist: it marks
-- at any range.
-- rationale: docs/decisions.md#beacon_waypoint
--
-- One of the two rows on this page still carrying a precondition at all, and it is a
-- presence test rather than a setting: there is no waypoint card to detect anything for --
-- the player placed it -- so what this needs is the mod that does the placing. Absent PAW
-- the row is a switch on nothing, and being absent on every visit reads as "you do not have
-- that mod" rather than as a menu that moved (docs/decisions.md#preconditions).
{ key = "beacon_waypoint", page = "beacons", def = true, type = "check", pre = "paw_here" },
-- ...and on your own COMPANIONS (R2.57). OFF by default. The second and last precondition
-- on this page, and a presence test for a related reason: there is no companion card to
-- detect anything for either, because the scan finds people you could act on and a
-- companion is someone you already did. It rides axr_companions' presence, the way the row
-- above rides PAW's.
--
-- The key is `beacon_party`, NOT `beacon_companions`, and the gap is load-bearing:
-- `mark_companions` one page over means a stalker you could RECRUIT and have not, which is
-- the disjoint set. Two rows a letter apart meaning opposite things is a support question
-- waiting to happen, so the whole feature says `party` in code, glyph key included.
-- rationale: docs/decisions.md#beacon_party
{ key = "beacon_party", page = "beacons", def = false, type = "check", pre = "party_here" },
-- What tints the marker. 0 accent (the gold everything else uses), 1 the colour that
-- role's PDA map spot carries, 2 the same but with turn-in markers taking the NPC's
-- FACTION colour instead. See BEACON_RGB for what each mode can and cannot colour.
--
-- 3 IS MODE 0 WITH A DIFFERENT ACCENT (R2.62): every marker takes beacon_r/g/b below
-- instead of the cards' col_r/g/b, and nothing else about the mode changes -- no role
-- colours, no faction override. It is a fourth entry on this list rather than a checkbox
-- beside it for the reason the list exists at all: what is being chosen is ONE thing, the
-- thing that decides a marker's colour, and a flag crossed with the modes would let the
-- player ask for the map's colours and their own at the same time.
-- rationale: docs/decisions.md#beacon_color
{ key = "beacon_color", page = "beacons", def = 2, type = "list",
  content = {
	{ 0, "iqm_bcol_accent"  },
	{ 1, "iqm_bcol_mapicon" },
	{ 2, "iqm_bcol_faction" },
	{ 3, "iqm_bcol_custom"  },
}},

{ section = "adv_beacons", page = "beacons", text = "ui_mcm_iqm_hdr_adv", clr = "adv" },
-- show the metre readout under the chevron
{ key = "beacon_range", page = "beacons", def = true, type = "check" },
-- range readout height, as a PERCENT of beacon_size. Sits directly under the switch it
-- modifies and must stay adjacent to it -- the reason survived losing the precondition it
-- was first written for; see docs/decisions.md#beacon_rsize.
-- rationale: docs/decisions.md#beacon_rsize
{ key = "beacon_rsize", page = "beacons", def = 40, type = "track",
  min = 25, max = 90, step = 5 },
-- Name above the marker. OFF by default, and not only for taste: it is the one part of
-- the badge that CANNOT scale with beacon_size (see draw_beacon), so it changes the
-- marker's proportions rather than adding to them.
{ key = "beacon_name", page = "beacons", def = false, type = "check" },
-- glyph size (px); the badge sizes itself around it
{ key = "beacon_size", page = "beacons", def = 23,  type = "track", min = 8,  max = 40,  step = 1 },
-- px inset from the screen edge where an off-screen beacon parks
{ key = "beacon_edge", page = "beacons", def = 20,  type = "track", min = 16, max = 140, step = 2 },
-- beacon opacity (0-255)
{ key = "beacon_a",    page = "beacons", def = 225, type = "track", min = 0,  max = 255, step = 5 },
-- The marker's OWN colour (R2.62), read only in beacon_color mode 3 and idle in the other
-- three -- shown regardless, like every other inert row (docs/decisions.md#preconditions).
-- Placed here, under the opacity and with no caption of its own, because that is exactly
-- where the route's three channels sit on its own page: a feature's colour belongs beside
-- its alpha in that feature's fine tuning, and this page having its colours where the other
-- two have theirs is worth more than being one row nearer the mode list up above.
--
-- Defaults are the accent's own 224/196/122, so choosing mode 3 changes nothing on screen
-- until a channel is moved. That is the point rather than a convenience: the mode is then a
-- STARTING POSITION and not a jump to some other colour, so a player who came to shift the
-- gold a little does not have to rebuild it first, and the marker cannot change colour at
-- the moment the mode is picked -- which would read as the option doing something else.
--
-- EVERY COLOUR CHANNEL IS step 1, as on the accent and both route pages.
-- rationale: docs/decisions.md#beacon_r--beacon_g--beacon_b
{ key = "beacon_r",    page = "beacons", def = 224, type = "track", min = 0,  max = 255, step = 1 },
{ key = "beacon_g",    page = "beacons", def = 196, type = "track", min = 0,  max = 255, step = 1 },
{ key = "beacon_b",    page = "beacons", def = 122, type = "track", min = 0,  max = 255, step = 1 },

-- ---- Centre falloff (R2.58) ----
-- Shrink and fade a marker as it approaches the crosshair, so it gets out of the way of
-- whatever you are actually looking at. Sits at the foot of the page because it is a
-- modifier on the two rows above it: it scales the size and the opacity you just set.
--
-- The RADIUS, as a percent of the half screen height -- so 35 reaches about a sixth of the
-- screen height out from the crosshair, and 100 reaches the top and bottom edges. A percent
-- of a screen fraction rather than pixels, because a pixel radius means a different circle
-- on every monitor, and this is a "how much of my view" setting.
--
-- 0 = OFF, the whole feature, and that is why there is no separate switch -- the same
-- arrangement dim_hold uses one page over. On by default: getting out of the way of the
-- crosshair is the behaviour this is for, and the floor below means nothing disappears.
-- rationale: docs/decisions.md#beacon_ctr
{ key = "beacon_ctr",   page = "beacons", def = 35, type = "track",
  min = 0, max = 100, step = 5 },
-- ...and its opacity floor, as a percent of what the marker would otherwise draw at. Idle
-- while the radius above is 0, and shown regardless (docs/decisions.md#preconditions).
--
-- 20 rather than 0 for the reason dim_level states: the default should be the behaviour
-- that cannot flicker, and a marker that vanishes outright at the centre reads as a bug
-- the first time you see it. 0 is a full hide and is deliberately reachable. Judge it
-- against a sunlit wall, not on paper -- alpha here is three multipliers deep already
-- (the card/marker handover, the combat dim, then this).
--
-- The SIZE floor is not offered: it is CTR_SMIN in iqm_beacon, which explains why.
{ key = "beacon_ctr_a", page = "beacons", def = 20, type = "track",
  min = 0, max = 100, step = 5 },
-- ...and whether it shrinks the badge as well as fading it. OFF by default, so the badge
-- holds beacon_size and the opacity does all of the work: a mark that changes size is a
-- mark whose position the eye has to find again, which is a real cost paid for what is
-- essentially a flourish. On restores the behaviour the feature shipped with, where the
-- marker visibly stands down as well as going quiet.
--
-- A check rather than a size-floor slider, and rather than folding "no shrink" into a
-- floor of 100: the two multipliers are answering different questions -- how much does the
-- marker get out of the way, and does it visibly stand down while it does -- and a slider
-- would invite tuning a number whose only interesting values are its two ends.
-- rationale: docs/decisions.md#beacon_ctr_size
{ key = "beacon_ctr_size", page = "beacons", def = false, type = "check" },

-- ==========================================================================
-- Route: ground -- direction arrows laid along the ground toward the same objective
-- NPC the beacon marks, over a route found on the AI level graph (iqm_route),
-- decided by iqm_nav and drawn as sprites by IqmCards:draw_route. Page id stays
-- "worldview" for the same storage-path reason as "cards" above.
--
-- Unlike the beacon this is NOT a proximity aid: route_dist limits how much of the
-- way you can SEE, not how near the target has to be, so a quest giver across the
-- level still gets you the next stretch of ground. It never says where they are,
-- only which way the ground goes, which is why the beacon's "don't make the game
-- easier" constraint doesn't carry over. Arrows do step aside once you are close
-- enough to see the NPC, since the card and beacon say the rest.
-- ==========================================================================
-- Both route pages need objective cards: the route leads to the objective NPC, so with
-- those off there is nothing to point at. When they are off the page shows a note
-- instead of a set of dead controls.
{ id = "route_no_targets", page = "worldview", type = "desc",
  text = "ui_mcm_iqm_route_no_targets", clr = "note", pre = "no_targets" },
-- Draw the ground route to the objective NPC. OFF by default: of everything the mod draws
-- this is the one that answers "how do I get there" rather than "who is that", which is a
-- larger change to how the Zone is read than a nameplate is, and so the one aid a player
-- is likeliest to want to decide about rather than be handed. The minimap trail ships off
-- for the same reason; either works without the other.
{ key = "mark_route", page = "worldview", def = false, type = "check" },

-- ---- Summoning the route --------------------------------------------------
-- WHEN the ground line is drawn, as opposed to where it goes. The acknowledged parent
-- of this route is Dead Space's RIG line (docs/ar-navigation.md), and until R2.58 this
-- mod had taken the LOOK of it and not the INTERACTION: their line is summoned by a
-- button, holds for a moment and fades. Ours stood there.
--
-- Summoned (2) is the strongest answer this mod has to its own "don't turn the Zone into a
-- waypoint chase" rule -- a route that exists only in the two seconds you asked for it
-- cannot be followed mindlessly -- and it is nearly free: iqm_nav BLANKS the ribbon rather
-- than dropping it (see its overlay branch), so bringing it back costs no search and no
-- repath.
--
-- IT IS NOT THE DEFAULT. Standing (0) is, because the route now ships behind mark_route
-- OFF: a player who goes looking for the feature and switches it on has asked for a route,
-- and answering that with a line that only appears while a key they may not have bound is
-- held would read as the switch not working. The summon is what you move to once the
-- standing line is more than you want, not the thing you have to find to see anything.
--
-- "Follow the nameplates" (1) is the pre-R2.58 behaviour kept as an option, not a
-- compatibility shim: the route was always gated on overlay_visible(), so a player using
-- the reveal hotkey in hold-to-show mode already had a summoned route and should be able
-- to keep exactly that.
{ key = "route_reveal", page = "worldview", def = 0, type = "list",
  content = {
	{ 0, "iqm_route_rv_always" },
	{ 1, "iqm_route_rv_cards" },
	{ 2, "iqm_route_rv_summon" },
}},
-- Tenths of a second the line HOLDS after the key comes up, before it fades. Tenths for
-- the same reason dim_hold is: MCM tracks are integers and 0.1 s is finer than anyone can
-- judge. 0 makes it a pure hold-to-show -- the fade starts the moment you let go -- which
-- is a legitimate setting and not a disabled one.
--
-- 30 (3.0 s) by default because the gesture has to survive a TAP. Dead Space's is a tap,
-- and a dwell shorter than a second turns "glance at the route" into "hold the button
-- down", which is a worse thing to ask of a player who is being shot at.
{ key = "route_dwell", page = "worldview", def = 30, type = "track",
  min = 0, max = 100, step = 5 },
-- The summon's OWN key, and -1 here means "use the nameplate key" rather than "off".
--
-- IT NEEDS TO EXIST, and that is worth being clear about, because one key looked like
-- enough. reveal_key = -1 means "nameplates always shown", and under a shared key that
-- same -1 has to mean "no summon gesture exists" -- so the most obvious way to want this
-- feature, nameplates permanently up with the route pulsed on demand, was the one
-- configuration that could not be expressed at all. Worse, with a key bound,
-- ui_mcm.simple_press only spares a HOLD from firing the toggle (ui_mcm.script:549), so a
-- TAP on the shared key always drags the nameplates with it -- and the tap is the
-- gesture.
--
-- Its own key removes both: nothing about the summon touches the nameplates, and the
-- reveal_mode 2 (long press) collision goes away with it. Defaulting to the shared key
-- keeps the zero-configuration case working.
{ key = "route_key",  page = "worldview", def = -1, type = "key_bind", pre = "has_keybinds" },
-- required modifier: 0 none, 1 shift, 2 ctrl, 3 alt. Only meaningful once route_key is
-- bound -- while it falls back to the nameplate key it borrows reveal_mod with it, since
-- a modifier that disagreed with the key it qualifies would just refuse to fire.
{ key = "route_mod",  page = "worldview", def = 0, type = "kb_mod", pre = "has_keybinds",
  hint = "mcm_kb_modifier", content = {
	{ 0, "mcm_kb_mod_none" },
	{ 1, "mcm_kb_mod_shift" },
	{ 2, "mcm_kb_mod_ctrl" },
	{ 3, "mcm_kb_mod_alt" },
}},
-- The never-strand note. An unbound key means "always drawn" for the route exactly as it
-- does for the nameplates (see reveal_visible), so a player who picks Summoned and binds
-- nothing gets the old always-on line rather than no line and no way to ask for one --
-- and has to be told, because silence there reads as a broken setting.
{ id = "route_summon_unbound", page = "worldview", type = "desc",
  text = "ui_mcm_iqm_route_summon_unbound", clr = "note", pre = "route_summon_unbound" },

-- Metres of route drawn AHEAD of the player, measured along the path from where you are
-- standing. NOT a limit on how far the target may be. Separate from the minimap trail's
-- own distance since R2.24; iqm_nav publishes at the longer of the two and each view
-- stops at its own. 1..80 in steps of 1 since R2.41 -- the step follows the floor, so
-- the two have to move together.
-- rationale: docs/decisions.md#route_dist
--
-- Nothing below clamps it up. A 1 m draw is a legitimate setting that shows one or two
-- marks at your feet, and the renderer already handles a length shorter than a single
-- segment (the nav harness pins that: "an impossibly short distance still leaves a
-- segment").
{ key = "route_dist", page = "worldview", def = 20, type = "track",
  min = 1, max = 80, step = 1 },
-- WHICH MARK IS PAINTED ON THE GROUND (R2.32, cut to three in R2.43), i.e. which of
-- RTE.SHAPES the ground marks are drawn as. All three point; the flatter shapes that did
-- not are gone.
-- rationale: docs/decisions.md#route_shape
--
-- THE NUMBERS ARE NOT 1, 2, 3 and must not be renumbered. They are the values MCM has
-- already written into players' ltx files, so 3, 7 and 8 go on meaning the shapes they
-- have always meant, and the five retired numbers fall through to the default in
-- read_config. RTE.SHAPES is keyed to match. 7 is the large chevron; the other two trade
-- size for a tighter point.
{ key = "route_shape", page = "worldview", def = 7, type = "list",
  content = {
	{ 3, "iqm_shape_arrow" },
	{ 7, "iqm_shape_chevtight" },
	{ 8, "iqm_shape_chevsharp" },
}},

-- route_xray is here and has no minimap counterpart because the trail ignores the
-- occlusion alpha entirely and draws opaque (see the note in iqm_minimap.script) -- so
-- this only ever governed the ground line.
{ section = "adv_world", page = "worldview", text = "ui_mcm_iqm_hdr_adv", clr = "adv" },
-- HOW HARD THE MARKS PULSE, 0-10. THE AMPLITUDE IS A FRACTION OF THE COLOUR'S HEADROOM,
-- not of the colour (R2.43a): 10 is "as bright as this colour goes with its hue intact";
-- 0 is off. It brightens rather than fading -- the tint MULTIPLIES the artwork -- and IT
-- IS A TRAVELLING WAVE, not a synchronised breath, phased off each mark's stable id
-- (RD.cn, R2.42) so the crest runs ALONG the route toward the target.
--
-- The honest limit: a colour already at 255 in some channel has no headroom and cannot
-- pulse.
-- rationale: docs/decisions.md#route_pulse
{ key = "route_pulse", page = "worldview", def = 6, type = "track",
  min = 0, max = 10, step = 1 },
-- Route opacity (0-255), fully opaque since R2.26. Whatever is set here is multiplied by
-- the near fade, the far fade and the occlusion verdict before it reaches the screen.
-- rationale: docs/decisions.md#route_a
{ key = "route_a", page = "worldview", def = 255, type = "track",
  min = 0, max = 255, step = 5 },
-- The route's OWN colour rather than the accent the cards and beacon share: a lifted
-- olive, back from the R2.33 amber at R2.40. The camo baked into the glyphs
-- (tools/stroke-tex, MARK_CAMO) only ever multiplies the tint DOWNWARD, so the base has
-- to be the bright end of the range. Set 134/152/86 in MCM for the deeper drab.
-- rationale: docs/decisions.md#route_r--route_g--route_b
{ key = "route_r", page = "worldview", def = 176, type = "track",
  min = 0, max = 255, step = 1 },
{ key = "route_g", page = "worldview", def = 196, type = "track",
  min = 0, max = 255, step = 1 },
{ key = "route_b", page = "worldview", def = 124, type = "track",
  min = 0, max = 255, step = 1 },
-- stretches behind cover fade down instead of vanishing
{ key = "route_xray", page = "worldview", def = true, type = "check" },

-- ==========================================================================
-- Route: minimap (F3) -- the same published route, drawn as marks on the HUD
-- minimap instead of on the ground. A second VIEW, not a second route -- see
-- docs/minimap-route.md. Off by default: plenty of GAMMA players run without a
-- minimap at all, and the feature has to be invisible to them rather than drawing
-- marks over empty screen.
--
-- No opacity knob anywhere on this page: the trail is drawn opaque. Marks are culled
-- before they reach the map's edge, so there is no boundary for a fade to soften, and
-- the two alphas tried before it both encoded something that belonged to the
-- first-person view. Section 6f of docs/minimap-route.md is three separate attempts
-- at fading them.
-- ==========================================================================
{ id = "mm_no_targets", page = "minimap", type = "desc",
  text = "ui_mcm_iqm_route_no_targets", clr = "note", pre = "no_targets" },
{ key = "mark_minimap", page = "minimap", def = false, type = "check" },
-- The trail's OWN drawn distance (R2.24), separate from route_dist. iqm_nav
-- publishes one list at the longer of the two and each stops at its own (see route_limit
-- there).
-- rationale: docs/decisions.md#minimap_dist
--
-- Chevron SPACING stays shared -- one route_gap for both. Splitting it would mean
-- publishing at the tighter of the two, and the chevron pool (MAX_CHEV) is already the
-- thing that truncates a long dense route, so the minimap could silently cut the ground
-- line short.
{ key = "minimap_dist", page = "minimap", def = 50, type = "track",
  min = 20, max = 80, step = 5 },
-- Which glyph the trail is made of: 0 arrows, 1 dots (iqm_minimap.STYLES).
-- Arrows carry the direction of travel and cost one SetHeading per mark; dots are the
-- quieter option on a busy map. Order matches iqm_minimap.STYLES.
-- rationale: docs/decisions.md#minimap_style
{ key = "minimap_style", page = "minimap", def = 1, type = "list",
  content = {
	{ 0, "iqm_mm_arrows" },
	{ 1, "iqm_mm_dots" },
}},

{ section = "adv_mm", page = "minimap", text = "ui_mcm_iqm_hdr_adv", clr = "adv" },
-- px: mark size in the 1024x768 virtual UI. The minimap is only ~85 of those units
-- across (docs/minimap-route.md section 8), so the usable range is small and the top of
-- it is already a mark a tenth the width of the map.
{ key = "minimap_size", page = "minimap", def = 4, type = "track",
  min = 4, max = 16, step = 1 },
-- The trail's own tint, and white by default -- which is what it has always drawn, so
-- the option changes nothing until it is used. Three tracks because MCM has no colour
-- type at all (ui_mcm.script:1005-1046 registers check/list/track/input/radio/key_bind
-- and nothing else), which is also why the ground route's colour is three rows. Its own
-- three keys rather than a share of the ground line's (route_r/g/b).
-- rationale: docs/decisions.md#minimap_r--minimap_g--minimap_b
--
-- A tint multiplies the art, so the black keyline baked into both glyphs survives any
-- colour set here -- the same property the PDA map icons rely on -- and the arrow style's
-- dark backing stays black, because it is the outline rather than part of the mark.
{ key = "minimap_r", page = "minimap", def = 255, type = "track",
  min = 0, max = 255, step = 1 },
{ key = "minimap_g", page = "minimap", def = 255, type = "track",
  min = 0, max = 255, step = 1 },
{ key = "minimap_b", page = "minimap", def = 255, type = "track",
  min = 0, max = 255, step = 1 },

}

-- Defaults, also the fallback when MCM is absent. Keys match the MCM option ids under
-- the "iqm" menu. Declared non-local so the menu file and the harnesses can read it as
-- iqm_core.DEFAULTS -- a DERIVED VIEW of OPTIONS since R2.46, not a second list.
-- Rows with no key (section captions, notes) contribute nothing, which is what stops a
-- `desc` row ever becoming an option read_config looks up.
DEFAULTS = {}

-- MCM page layout: which subpage each option sits on. MCM stores a subpage option under
-- "iqm/<page>/<key>", so read_config forms the storage path from this.
--
-- A "cards" key is deliberately ABSENT rather than listed, because read_config's path is
-- (PAGE_OF[key] or "cards") and the table has always meant "the exceptions". Deriving it
-- any other way would change what is in it without changing what it resolves to, and the
-- one property worth protecting here is that every stored path stays byte-identical.
PAGE_OF = {}

for _, o in ipairs(OPTIONS) do
	if o.key and o.def ~= nil then
		DEFAULTS[o.key] = o.def
		if o.page ~= "cards" then PAGE_OF[o.key] = o.page end
	end
end


-- ==========================================================================
-- THE SHARED-STATE SEAM (R2.45, when iqm_scan / iqm_cards / iqm_beacon split off)
-- ==========================================================================
-- Four things used to be reached freely from code that now lives in three other
-- files. Who owns each, and how the others get at it:
--
--   `C`, the live config.  OWNED HERE, and there is exactly one of it. read_config
--     writes into this table and NEVER REBINDS IT -- that invariant is what lets the
--     other modules bind the same table once (iqm_core.config()) and read it
--     forever without a refresh path. It is PULLED, not pushed: read_config's last
--     act is to call each module's apply_config(), and each module reaches over for
--     what it wants. There is deliberately no configure({...}) payload left. The three
--     that survived the split -- iqm_taskwork, iqm_nav, iqm_minimap -- were turned
--     round at R2.47, and the gates read_config used to compute FOR them went with
--     them: the work probe's appear_dist reach is iqm_taskwork.apply_config's, the
--     route's on/draw rules are iqm_nav's. Their configure() entry points remain, and
--     are now only what the harnesses drive, since a harness has no iqm_core to
--     pull from.
--
--   The DERIVED RANGE MIRRORS (appear2, beacon2, ...).  OWNED HERE, computed in
--     read_config, and COPIED by whoever needs one, through ranges(). Copies rather
--     than a shared table because they are numbers read per NPC per frame, and the
--     whole point of a mirror is that reading it is not a hash lookup (see the note
--     on the render-path mirrors below). A copy is only ever stale for the instant
--     between two reads of the same config change, and apply_config closes that.
--
--   `tracked` and `FILT`.  OWNED HERE AND PRIVATE. Nothing outside this file reads
--     or writes either, and nothing should: the scan hands over a desired SET and
--     this file turns it into slots, filter records and widgets. Two modules writing
--     one table through the namespace is the failure the split exists to prevent.
--
--   `CARDS`, the dialog.  The CLASS is iqm_cards'; the INSTANCE is this file's,
--     because creating it is lifecycle and lifecycle stayed here. iqm_beacon draws
--     through it and is handed it as an argument rather than reaching for it, so
--     there is no second holder of a handle that outlives a level.
--
-- The projection helpers split by who is hot in them: anchor_world_pos /
-- project_world / shoulder_sign stay here with the per-card frame path that uses
-- them (iqm_scan asks for the one answer it needs through npc_on_screen), and
-- project_off / UI_KX went to iqm_cards with the route and badge geometry.
-- ==========================================================================
local C          = {}     -- live config (DEFAULTS overlaid with MCM values)
local tracked    = {}     -- [npc_id] = { role = "target"|"guide"|"companion", slot = n }
local FILT       = {}     -- [npc_id] = smoothing/alpha state
local CARDS      = nil    -- the IqmCards dialog instance
local next_scan  = 0
local smooth_tau = 38.7   -- derived from C.smoothing in read_config (0 = instant)
local SNAP2      = 260 * 260

-- Render-path config mirrors, refreshed in read_config: these are read per
-- tracked NPC per frame, so they live in locals instead of hashing into C
-- each time. appear2 is the squared range gate (compared against
-- distance_to_sqr, so the out-of-range case never pays the sqrt).
local appear_d, appear2, full_d = 16, 16 * 16, 9
local node_min, auto_side, side_amt = 0.5, true, 0.18
-- Focus mirrors (the focus_* options; see their block in OPTIONS for the feature).
-- ONE table for the same reason SUP is one: it is a whole feature's config and it must
-- not cost seven of this file's 198 names.
--
--   on      the feature is on at all. Every focus test is behind this, so with it off
--           the per-NPC cost is one boolean read and nothing else.
--   prio    ROLE_PRIO at or below which a card is EXEMPT (FOCUS_PRIO[mode])
--   r/r2    the ring's outer radius, in virtual-UI-Y units, and its square
--   ri/ri2  the inner radius (solid inside it), and its square
--   floor   what a card outside the ring fades to, 0..1
--   kxi     1/UI_KX, refreshed once per frame in render: it converts a UI-X delta into
--           the same units as a UI-Y one, which is what makes the ring a circle on
--           screen rather than an ellipse (see focus_factor)
--   flip    a card crossed the ring edge this frame -- the re-rank trigger
--   sat     the slots were contended on the last pass; `flip` only matters then
--   next    debounce deadline for that re-rank, in time_global ms
local FOC = {
	on = false, prio = 0, r = 192, r2 = 192 * 192, ri = 115.2, ri2 = 115.2 * 115.2,
	floor = 0, kxi = 1, flip = false, sat = false, next = 0,
}
-- Which ROLE_PRIO tier each mode exempts. Keyed by the option's value; a mode with no
-- entry (0, off) leaves FOC.on false and none of this is reached.
local FOCUS_PRIO = { [1] = 4, [2] = 1, [3] = 0 }
-- ms between focus-driven re-ranks. The slot rank is otherwise rebuilt on SCAN_INTERVAL,
-- which is 2 s -- far too slow for a filter that answers a head turn -- so crossing the
-- ring pulls the merge forward. Debounced, because sweeping across a camp crosses it
-- repeatedly and the merge is the most expensive thing this file does.
local FOCUS_RERANK = 250
-- beacon mirrors; beacon2 is the squared outer gate (always >= appear2, so the
-- card's own range test stays the inner one).
local beacon_d, beacon2 = 60, 60 * 60
-- (The extras scan's own reach, extra2, was derived here until R2.45. It is read per
-- NPC by exactly one consumer -- iqm_scan's extras pass -- and nothing here ever
-- looked at it, so it is derived in iqm_scan.apply_config from the two ranges below.
-- The RULE it encodes is unchanged and the note explaining it went with it.)
-- Whether game.world2ui_with_depth exists (modded exes). The route projects with
-- it exactly as the beacon does, so on a bare Anomaly exe both drop out together
-- and the cards are unaffected.
local w2u_ok = false
-- Combat dim: the live state behind the dim_* options (see their block in OPTIONS for
-- what the feature is and why it is a floor rather than a hide).
--
-- ONE TABLE, and not five file locals, for the reason the whole file is careful about:
-- a .script body is a single Lua function with 198 locals to spend, and this file spent
-- 193 of them before the R2.45 split. There is room now, but the five CALLBACK HANDLERS
-- are fields on this table too (SUP.on_fired and friends), which keeps a feature that is
-- five engine hooks wide costing exactly one name.
--
--   ms/lvl/cards/beacons  config mirrors, refreshed in read_config. ms == 0 is OFF.
--   ads                   sights are up right now: a STATE, so it has no deadline
--   till                  ...whereas every other trigger stamps one, in time_global ms
--   f                     the eased multiplier, 1 (clear) down to lvl (fully dimmed)
--   fc/fb                 f, or a flat 1 where that overlay opted out. Precomputed once
--                         per frame so the two draw sites are a bare multiply
--   t                     last frame's tg, for a framerate-independent ease
--
-- HIT is the filter on actor_on_before_hit, and it is not optional. That callback fires
-- for ALL damage, radiation and burn ticks included, and those tick every frame -- so an
-- unfiltered handler re-stamps `till` continuously and pins the overlays dimmed for as
-- long as you stand in a hot spot. Only the ways a fight hurts you are listed: 5 wound,
-- 6 fire_wound, 7 strike, 8 explosion, 9 wound_2 (ALife::EHitType, alife_space.h). Burn,
-- shock, chemical, radiation, telepatic and light_burn are the environment, not combat.
local SUP = {
	ms = 0, lvl = 0.35, cards = true, beacons = true,
	ads = false, till = 0, f = 1, fc = 1, fb = 1, t = 0,
	HIT = { [5] = true, [6] = true, [7] = true, [8] = true, [9] = true },
}
-- Out fast, back slowly. Asymmetric on purpose: a firefight re-triggers constantly, and
-- a fade-in as quick as the fade-out turns sustained fire into a strobe. These are fixed
-- rather than options because "quickly" is the specification -- the player's control is
-- how FAR it goes (dim_level) and how LONG it stays (dim_hold), not how fast it moves.
local DIM_OUT_TAU = 60    -- ms: time constant easing down to the floor
local DIM_IN_TAU  = 170   -- ms: ...and back up to clear

-- The SUMMON envelope: the ground route's own visibility, over and above the three gates
-- every other overlay takes (see the route_reveal block in OPTIONS for what the feature is).
-- ONE table for the same reason SUP is one -- a feature that is four options and three
-- pieces of live state costs exactly one name out of the file's 198.
--
--   a       the applied multiplier, 0..1, eased. LANDED on 0 and 1 rather than
--           approached, because both ends are load-bearing: 0 is what lets iqm_nav
--           throttle its tick and this file skip the draw, and a multiplier that only
--           ever reached 0.003 would keep both doing full work for a line nobody can see.
--   till    time_global ms the dwell expires at -- stamped on the RELEASE EDGE, so a tap
--           and a hold are one gesture with the same code behind them
--   down    was the key down last frame, for that edge
--   dwell   config mirror of route_dwell, in ms (the option is tenths)
--   t       last frame's tg, for a framerate-independent ease
--
-- THE KEY IS POLLED, not latched off on_key_press/on_key_release, and that is not a style
-- choice: those two callbacks are gated on KEYS_UNLOCK (bind_stalker_ext), so a release
-- pressed "through" a scripted GUI opening is never delivered. A latched summon would
-- stick on until the key was pressed again; polling finds the edge itself on the next
-- frame and cannot get stuck. Same reasoning as reveal_mode 3, and the same one engine
-- call to pay for it.
local SMN = { a = 0, till = 0, down = false, dwell = 2000, t = 0 }
-- In fast, out slow -- the asymmetry Dead Space's line has, and the opposite emphasis to
-- the combat dim's. The summon is a REPLY to a button and must feel immediate; the fade is
-- the part the player watches, and a fade as quick as the appearance reads as the route
-- being switched off rather than expiring. Fixed rather than options: the player's control
-- is how LONG it stays (route_dwell), which is the axis worth having.
local SMN_IN_TAU  = 70    -- ms: time constant fading the route up on the gesture
local SMN_OUT_TAU = 450   -- ms: ...and back down once the dwell expires
local FADE_TAU    = 90    -- ms: framerate-independent fade in/out time constant
local APPEAR_TAU  = 70    -- ms: entrance rise/settle time constant
local APPEAR_LIFT = 7     -- px the card rises into place as it first appears
local SOUND_PATH  = "iqm\\iqm_alert"  -- bundled phone-vibrate alert (gamedata\sounds\iqm\iqm_alert.ogg)
local SOUND_CD    = 12000 -- ms: per-NPC cooldown so brief occlusions/glances don't re-chirp
local _chirp_snd  = nil   -- cached sound_object (created lazily on first play)
local _chirp_last = 0     -- global throttle so simultaneous appearances don't stack
local DEBUG       = false -- mirrors the MCM debug_log option (set in read_config)
local _dbg_t      = 0

-- Hot math globals localised (per-frame projection/draw path) to avoid repeated global
-- table lookups. math.log only runs one-time (read_config) so it's left as-is.
local floor, max, sqrt = math.floor, math.max, math.sqrt
local exp, abs = math.exp, math.abs
-- (sin, cos, atan2 and min went to iqm_cards and iqm_beacon with the drawing that used
-- them: the node's breathing pulse, the route's travelling wave, place_mark's circular
-- mean of the two angle candidates, the marker's screen-edge clamp. What is left here
-- is the fade curve and the distance arithmetic, which need no trigonometry.)

local pairs = pairs   -- iterator on the per-frame path
-- Other hot globals on the per-frame path, localised for the same reason.
local time_global, get_obj = time_global, nil  -- get_obj bound in on_game_start (level.* not ready at parse)
-- The card window's own drawing space, bound in on_game_start. The marker geometry
-- below projects and clamps in exactly the space the route and the badges are drawn
-- in, so it takes the projection, the aspect correction and the marker pool's size
-- from the module that owns that space rather than keeping a second opinion about
-- No fallback values: nothing here draws at all without that module, since the dialog
-- every widget lives on comes from it, so a default would be a second opinion about a
-- number rather than a safety net.
-- ...and the aspect factor that tick keeps current, which focus mode reads once per
-- frame (FOC.kxi). Bound beside its tick rather than reached for through the namespace
-- because they are the same value's two halves and only one file owns it.
local cards_kx_tick, cards_kx = nil, nil
-- iqm_beacon's entry points, bound the same way. The marker's own state -- which roles
-- carry one, its glyph and tint, the candidate set, the placed waypoint -- all live
-- over there; what stays here is the per-NPC loop that offers to it, because that loop
-- is the card pass and already has each NPC's object, distance and eased alpha in hand.
local beacon_offer, draw_beacons, hide_beacons = nil, nil, nil
local waypoint_goal, offer_waypoint = nil, nil
-- ...and the selected task's pair, which work exactly the same way (R2.46).
local task_goal, offer_task = nil, nil
-- ...and the party's offer (R2.57), which has no _goal twin: there is no single id to
-- resolve, so the whole loop is over there and this file passes in the three things only
-- it can answer -- the actor's position, the marker's range mirror, and `marked`.
local offer_party = nil
local beacon_roles, BEACON_ICON, BEACON_RGB = nil, nil, nil
-- Interference: the envelope's per-frame entry point, and its published state table.
-- Bound in on_game_start like everything else here. `NZ` is THE table iqm_noise mutates,
-- never a copy -- this file reads one field off it (the alpha multiplier) at the two draw
-- sites, next to where the combat dim's own multiplier is applied.
local noise_tick, NZ = nil, nil
-- character_community, localised for the same reason: read once per tracked NPC in
-- update() to resolve its faction. Bound in on_game_start alongside get_obj, since
-- these script/engine globals aren't all guaranteed to exist when this file is
-- first parsed.
local char_comm = nil
-- iqm_taskwork entry points (probe_tick per frame, work_kind per work card per
-- update), bound in on_game_start like the rest so a missing module just no-ops.
-- (has_work is per scanned NPC and is bound by iqm_scan, which is what scans.)
local tw_tick, tw_kind = nil, nil
-- iqm_scan's entry points, bound in on_game_start like everything else that crosses
-- a module boundary -- never at file scope, because iqm_scan reads THIS module back
-- and a file-scope read on both sides of that pair would let the load order decide
-- which one sees a half-built namespace. ROLE_PRIO and slot_order_cmp are the same
-- tables/functions that file uses, not copies: the card slots and the marker slots
-- must sort by one ordering or they drift apart (R2.39).
local scan_desired, scan_tick, scan_idle, scan_reset = nil, nil, nil, nil
-- iqm_scan.marker_set: [id] = the role that NPC's MARKER wears, which is not always
-- the role its CARD wears. Read on the same pass as scan_desired -- see want_marker
-- there for why the two differ and marker_set for why it must be the same pass.
local scan_marker = nil
local hire_price_of, slot_order_cmp, ROLE_PRIO = nil, nil, nil
local scan_talk_to = nil
-- ...and iqm_scan.task_kind, "mutant" / "bounty" / nil, read once per selected task in
-- active_task_target. Bound like the rest so an older iqm_scan just leaves it nil and
-- every task falls back to the ordinary reticle.
local scan_task_kind = nil
-- HUD-visibility globals, also bound in on_game_start: main_hud_shown() is base
-- _g.script (the check the rest of GAMMA's HUD mods use) and axr_main carries the
-- live zoom flags. Both are read once per frame in hud_is_shown().
local hud_shown_fn, axr = nil, nil
-- Reveal-hotkey state. key_state_fn is the engine's live physical-key poll
-- (bound in on_game_start with the rest); mcm_keybinds is the MCM >= 1.6.0 keybind
-- feature test every GAMMA mod uses -- ui_mcm.key_hold only exists from that version,
-- and the modifier/mode helpers arrived with it.
local key_state_fn  = nil
local mcm_keybinds  = false
local reveal_on     = true   -- toggle state (modes 0-2); hold-to-show (3) ignores it

-- Header text is fixed per role, so translate once and cache instead of calling
-- game.translate_string every frame in the draw path. Cleared on config change.
local _hdr_cache = {}

-- easeOutQuint: fast start, gentle settle. Used for the entrance rise.
local function ease_out_quint(x)
	if x < 0 then x = 0 elseif x > 1 then x = 1 end
	local u = 1 - x
	return 1 - u * u * u * u * u
end

-- Bones to anchor the node to, best first: left chest/shoulder, then chest, then head.
local ANCHOR_BONES = { "bip01_l_clavicle", "bip01_spine2", "bip01_spine1", "bip01_spine", "bip01_head" }

-- --------------------------------------------------------------------------
-- Config
-- --------------------------------------------------------------------------
--- The live config table, for the modules that PULL from it (see the seam note).
--
--  An accessor rather than a bare namespace field, so `C` can stay a file LOCAL here
--  -- every option on the per-frame draw path is read off it, and reaching those
--  through the module's namespace table would put a hash lookup on each one. Callers
--  bind the result once, in their apply_config, and keep it: read_config mutates this
--  table and never replaces it, which is the whole contract.
function config()
	return C
end

--- The two squared range gates, for the same callers. COPIES on the other side, since
--  they are numbers -- so anything holding one must re-take it in apply_config, which
--  is exactly when it can have changed.
function ranges()
	return appear2, beacon2
end

--- Whether game.world2ui_with_depth exists, for iqm_beacon: nothing it draws can be
--  placed without it, so the whole role gate rides this. Read rather than recomputed
--  so both modules answer from one probe.
function w2u()
	return w2u_ok
end

-- (Metres of route iqm_nav should publish -- the max over ENABLED views -- was derived
--  here until R2.47, when the last three push adapters went. It is iqm_nav.draw_dist
--  now, next to the search it sizes, and it reads the same two option pairs and the same
--  w2u() probe it always did. The ground line still asks how much of that published list
--  is its own, through iqm_nav.route_draw; see overlay_visible below.)

--- Rebuild `C` from the menu, then hand round.
--
--  AFTER THIS RUNS, C[key] IS NON-NIL FOR EVERY KEY IN DEFAULTS -- the loop below starts
--  each key at its default and only replaces it with a value MCM actually returned, so
--  there is nothing that can leave a hole. That is why no reader anywhere writes
--  `C.<key> or <literal>`: there were forty-three of those until R2.46, none of them
--  reachable, and FOUR had drifted from the defaults they were restating --
--  beacon_size 24 (really 14), route_a 215 (255), route_pulse 0 (6), sound_vol 0.7 (0.9).
--  Dead code that states a number wrongly is worse than dead code, because the next call
--  site is written by copying one of them.
local function read_config()
	for key, default in pairs(DEFAULTS) do
		local v = default
		if ui_mcm and ui_mcm.get then
			-- options live under a per-feature subpage, so the stored path is
			-- "iqm/<page>/<key>" (see PAGE_OF / iqm_mcm.script).
			local got = ui_mcm.get("iqm/" .. (PAGE_OF[key] or "cards") .. "/" .. key)
			if got ~= nil then v = got end
		end
		C[key] = v
	end
	DEBUG = C.debug_log and true or false
	_hdr_cache = {}   -- rebuild header strings lazily (covers a language change too)
	-- treat "smoothing" as the per-frame gap fraction at 60fps, converted to a
	-- time constant so the ease feels the same at any framerate.
	local sm = C.smoothing
	if sm >= 1 then smooth_tau = 0 else smooth_tau = -16.67 / math.log(1 - sm) end
	local sd = C.snap_dist; SNAP2 = sd * sd

	-- refresh the per-frame config mirrors (see their declaration)
	appear_d  = C.appear_dist
	appear2   = appear_d * appear_d
	full_d    = C.full_dist
	node_min  = C.node_min
	auto_side = C.auto_side and true or false
	side_amt  = C.side_amt

	-- Focus (see FOC). Both radii are derived here so the per-NPC test is a compare
	-- against a squared constant: the option is a percentage of the virtual UI's 768-unit
	-- height, and the soft edge is a percentage of the radius it softens.
	FOC.prio = FOCUS_PRIO[C.focus_mode] or 0
	FOC.on   = FOCUS_PRIO[C.focus_mode] ~= nil
	FOC.r    = C.focus_radius * 0.01 * 384
	FOC.r2   = FOC.r * FOC.r
	FOC.ri   = FOC.r * (1 - C.focus_soft * 0.01)
	FOC.ri2  = FOC.ri * FOC.ri
	FOC.floor = C.focus_floor * 0.01
	-- Turning it off mid-dim must not leave a card stuck at the floor, for the reason the
	-- combat dim resets itself below: nothing moves f.fa but the per-frame ease, and with
	-- the feature off that ease has stopped being asked for. clear_all() in
	-- on_option_change drops FILT wholesale, so this only has to be right for a config
	-- read that does NOT come through the menu (the one at load).
	if not FOC.on then
		FOC.flip, FOC.sat, FOC.next = false, false, 0
		for _, f in pairs(FILT) do f.fa, f.fon = 1, nil end
	end

	-- Combat dim (see SUP). The option is tenths of a second and the deadline arithmetic
	-- is in time_global ms, so the conversion happens once here rather than per trigger.
	SUP.ms      = C.dim_hold * 100
	SUP.lvl     = C.dim_level / 100
	SUP.cards   = C.dim_cards and true or false
	SUP.beacons = C.dim_beacons and true or false
	-- Turning the feature off mid-dim must not leave the overlays stuck at the floor:
	-- nothing clears `f` except the per-frame ease, and with ms at 0 the ease has already
	-- stopped being asked for. Same for a hold shortened below what is already elapsed.
	if SUP.ms <= 0 then
		SUP.ads, SUP.till, SUP.f, SUP.fc, SUP.fb = false, 0, 1, 1, 1
	end

	-- The summon envelope (see SMN). Tenths of a second in the menu, time_global ms here,
	-- converted once rather than per frame.
	SMN.dwell = C.route_dwell * 100
	-- Leaving Summoned must not leave the route stuck mid-fade or mid-dwell. `a` is
	-- deliberately NOT reset with them: the ease is still running every frame and will
	-- carry it to whatever the new mode wants, which is a fade rather than a jump.
	if C.route_reveal ~= 2 then SMN.down, SMN.till = false, 0 end

	-- The beacon needs world2ui_with_depth for its behind-camera sign; plain
	-- world2ui can't distinguish "off the left edge" from "behind you", and getting
	-- that wrong points the chevron exactly backwards. It ships with the modded
	-- exes (and so with GAMMA), but this mod runs on bare Anomaly too, so treat it
	-- as a soft dependency and drop just the beacon if it isn't there.
	local bok = game.world2ui_with_depth ~= nil
	w2u_ok = bok    -- the route projects with the same binding, so it shares the gate
	if C.mark_beacon and not bok and DEBUG then
		printf("[IQM] beacon disabled: game.world2ui_with_depth missing (needs the modded exes)")
	end
	-- (The ROLE GATE -- which roles carry a marker, and the placed waypoint's own
	-- switch -- is rebuilt from these same options by iqm_beacon.apply_config, which
	-- owns the table. It reads `bok` back through w2u() so both halves answer from
	-- this one probe.)
	--
	-- the beacon lives outside the card's range, never inside it: a beacon_dist
	-- below appear_dist would leave a band where neither the card (faded out) nor
	-- the beacon (out of range) marks the objective.
	--
	-- These two stay HERE, unlike the marker's other knobs, because they are read on
	-- the per-NPC card pass below (which decides whether an NPC is a marker candidate
	-- at all) rather than by anything that draws one.
	beacon_d     = max(appear_d, C.beacon_dist)
	beacon2      = beacon_d * beacon_d
	-- The look of the marks, the route and the readout is iqm_cards' own, and the
	-- marker's is iqm_beacon's; both PULL what they need at the foot of this function
	-- (apply_config). The aspect correction goes with the drawing, since it is
	-- measured off the device rather than read off an option.

	-- The SEARCH's own narration, which nothing has ever switched on (R2.33d). iqm_route
	-- carries a `verbose` flag and the only writer of it was the literal `false` at its
	-- declaration, so its diagnostics -- "route found: N nodes explored", and crucially
	-- "gave up after N nodes; partial route (closest approach X m)" -- have never reached
	-- a log. That mattered: a player's log showed 95 of 107 routes coming back PARTIAL,
	-- `partial` is set in exactly one place (the max_nodes branch), and the numbers that
	-- would say how far over budget the search ran were the ones not being printed.
	-- Still PUSHED, and the last thing here that is. iqm_route owns no config of its own
	-- and has no apply_config to call; gating this on iqm_nav's presence to fold it in
	-- there would silence the search's diagnostics on an install missing that module,
	-- which is exactly the install you would want them from.
	if iqm_route then iqm_route.verbose = DEBUG and true or false end

	-- ...and finally the modules that PULL rather than being pushed at (see the seam
	-- note at the top). Last on purpose: every value they reach for -- C, the range
	-- mirrors, beacon_roles, w2u() -- is settled by the time they look. iqm_beacon
	-- first, because iqm_scan's own reach is derived from the role gate iqm_beacon
	-- rebuilds.
	--
	-- Nothing is marshalled and nothing is duplicated; each call is "your turn to
	-- re-read". The three configure({...}) payloads that used to sit above this -- for
	-- iqm_taskwork, iqm_nav and iqm_minimap -- were the last of the push model and are
	-- gone; the gates they computed (which is to say, the rules for how far the work
	-- probe reaches and how much route each view wants) now live in the modules that act
	-- on them. The `and .apply_config` guards are the soft-dependency tests those three
	-- always had: each is optional, and a missing one must no-op rather than error.
	if iqm_taskwork and iqm_taskwork.apply_config then iqm_taskwork.apply_config() end
	if iqm_nav      and iqm_nav.apply_config      then iqm_nav.apply_config()      end
	if iqm_minimap  and iqm_minimap.apply_config  then iqm_minimap.apply_config()  end
	if iqm_taskspot and iqm_taskspot.apply_config then iqm_taskspot.apply_config() end
	if iqm_spothint and iqm_spothint.apply_config then iqm_spothint.apply_config() end
	if iqm_squadspot and iqm_squadspot.apply_config then iqm_squadspot.apply_config() end
	iqm_beacon.apply_config()
	iqm_scan.apply_config()
	-- iqm_noise BEFORE iqm_cards, because iqm_cards binds the published state table in its
	-- own apply_config and the mirrors on it must already be the new ones. Binding the
	-- table itself would be safe either way -- it is never rebound -- but reading `on`
	-- from it a call too early would not be.
	iqm_noise.apply_config()
	iqm_cards.apply_config()
end

-- --------------------------------------------------------------------------
-- Slot bookkeeping (one card widget-set per marked NPC)
-- --------------------------------------------------------------------------
local function free_slot()
	local used = {}
	for _, t in pairs(tracked) do
		if t.slot then used[t.slot] = true end
	end
	for i = 1, MAX_CARDS do
		if not used[i] then return i end
	end
end

-- The three writers of `tracked` all drop the cached route goal (route_goal_reset, defined
-- with the cache further down -- a namespace field, so calling it from up here resolves at
-- run time rather than at parse time). route_target's FALLBACK is "the nearest tracked
-- `target` role", so every one of these can change the answer by adding, retyping or
-- removing the very entry it would pick -- and a newly-appearing objective must not sit
-- behind a cached nil for the rest of the throttle window.
--
-- Deliberately NOT reset on the re-entry path where an existing id keeps the role it
-- already had: that is what every scan does to every carded NPC, so resetting there would
-- be a reset per scan pass and the cache would be worth nothing.
local function ensure_entry(id, role)
	local t = tracked[id]
	if t then
		if t.role ~= role then route_goal_reset() end
		t.role = role
		return
	end
	local slot = free_slot()
	if not slot then
		if DEBUG then printf("[Immersive Quest Markers] more than %s NPCs to card; extras skipped this scan", MAX_CARDS) end
		return
	end
	tracked[id] = { role = role, slot = slot }
	FILT[id] = { a = 0 }
	route_goal_reset()
end

local function remove_entry(id)
	local t = tracked[id]
	if t and t.slot and CARDS then CARDS:hide_slot(t.slot) end
	tracked[id] = nil
	FILT[id] = nil
	if t then route_goal_reset() end
end

local function clear_all()
	for _, t in pairs(tracked) do
		if t.slot and CARDS then CARDS:hide_slot(t.slot) end
	end
	tracked = {}
	FILT = {}
	route_goal_reset()
end

-- --------------------------------------------------------------------------
-- Per-frame helpers
-- --------------------------------------------------------------------------
-- World-space anchor on the NPC (left chest/shoulder, falling back through the
-- spine to the head). Shared by the on-screen projection and the LOS ray so both
-- agree on the same point.
--  WHICH bone answers is a property of the MODEL, so it is resolved once per NPC and
--  remembered on that NPC's filter record instead of re-probed every frame. The pcall is
--  the reason this matters: it is NYI in LuaJIT, so each one aborts the compiled trace
--  back to the interpreter, and a model whose clavicle is missing (a fair few) walked the
--  whole list and paid FIVE of them per card per frame, for as long as it was carded.
--
--  `id` is optional. The recruit scan (companion_scan_one) has no filter record for its
--  candidates and is budget-amortized anyway, so it falls through to the full probe.
local function anchor_world_pos(obj, id)
	local pos
	-- pass the method + args to pcall directly (no wrapper closure): this runs once
	-- per card per frame, and a fresh closure each call would be needless GC churn.
	local f = id and FILT[id]
	local hit = f and f.bone
	if hit then
		local ok, p = pcall(obj.bone_position, obj, ANCHOR_BONES[hit])
		-- a cached bone that stops answering (model swap) falls back to a fresh probe
		if ok and p then pos = p else f.bone = nil end
	end
	if not pos then
		for i = 1, #ANCHOR_BONES do
			local ok, p = pcall(obj.bone_position, obj, ANCHOR_BONES[i])
			if ok and p then pos = p; if f then f.bone = i end; break end
		end
	end
	if not pos then
		pos = obj:position()
		pos.y = pos.y + 1.2
	end
	pos.y = pos.y + C.head_lift   -- vertical nudge (0 = right on the bone)
	-- Horizontal right-axis (unit, ground plane) tracking the NPC's facing, plus the
	-- manual head_side nudge (+ = NPC's right, - = their left). The auto shoulder pick
	-- (which side of the torso the node sits on) is done in render() where we can project,
	-- so it works at any camera angle. Returns the base point and the right-axis so render
	-- can offset onto whichever shoulder faces the card.
	local dir = obj:direction()
	local rx, rz = -dir.z, dir.x                   -- horizontal perpendicular to facing
	local rl = sqrt(rx * rx + rz * rz)
	if rl > 0.001 then rx, rz = rx / rl, rz / rl else rx, rz = 0, 0 end
	local side = C.head_side
	if side ~= 0 then
		pos.x = pos.x + side * rx
		pos.z = pos.z + side * rz
	end
	return pos, rx, rz
end

-- Project a world point to the screen ourselves (world2ui, same as mag_check_ui,
-- which lines up with our own dialog). Returns nil when off-screen / behind camera.
-- world2ui can mutate its argument, so we hand it a reusable scratch copy (its result
-- is read immediately, so one shared scratch is safe) and keep `pos` intact.
local _w2u = vector()   -- scratch handed to world2ui; never overlaps its own result
local function project_world(pos)
	local ui = game.world2ui(_w2u:set(pos), false, false)
	if not ui or ui.x < -9000 then return nil end
	return ui.x, ui.y
end

-- Which shoulder (which sign along the body right-axis) should the node sit on, so the
-- leader line meets the near shoulder instead of crossing the torso. Projecting both
-- candidates makes this correct at any camera angle / handedness (a facing-only guess
-- flips at oblique angles). Returns +1 (base + right*amt), -1 (base - right*amt), or 0
-- (a candidate is off-screen; stay centred). This is the only per-NPC work that needs
-- TWO extra projections, so render throttles how often it's called (SIDE_RATE) and reuses
-- the chosen sign in between; the choice barely changes frame to frame.
local _sv = vector()   -- scratch for the two shoulder candidates (project_world copies it)
local function shoulder_sign(base, rux, ruz, amt)
	local ax = project_world(_sv:set(base.x + rux * amt, base.y, base.z + ruz * amt))
	local bx = project_world(_sv:set(base.x - rux * amt, base.y, base.z - ruz * amt))
	if not ax or not bx then return 0 end
	-- the card sits to the right of the head unless there's no room there (then it flips
	-- left); put the node on the same side so the line doesn't cross the body.
	local mid = (ax + bx) * 0.5
	local card_right = (mid + C.card_off_x + 200) <= 1014
	if card_right then
		return (ax >= bx) and 1 or -1                 -- further-right candidate
	else
		return (ax <= bx) and 1 or -1                 -- further-left candidate
	end
end
local SIDE_RATE = 120   -- ms between auto-shoulder re-picks (reuse the sign in between)

-- Phase spreader for the two per-NPC deadlines below (the LOS cast and the shoulder
-- re-pick). Both are advanced by a CONSTANT once running, so any set of NPCs whose
-- FIRST deadline is seeded on the same frame stays phase-locked for as long as they are
-- all carded -- and they are seeded together exactly when it hurts: rounding a corner
-- into a bar, a squad cresting a ridge, a fast-travel arrival. So the first deadline,
-- and only the first, is scattered across its own interval by the NPC's id.
--
-- The obvious `id % rate` is NOT enough, and was tried first. A squad is created
-- together and so carries CONSECUTIVE alife ids, which `id % rate` maps to deadlines
-- ONE MILLISECOND apart -- eight of them still land inside the same 16 ms frame, which
-- is the whole case this exists for. Multiplying first spreads consecutive ids by
-- PHASE_MUL ms instead: 53 is prime and cannot divide any los_rate the option offers
-- (50..500 in tens) nor SIDE_RATE, so the map is a full cycle over the interval rather
-- than a handful of buckets. The id is used rather than a counter because it is stable:
-- an NPC that walks out of range and back does not re-roll into its neighbour's slot.
local PHASE_MUL = 53

--- Would this NPC's card land on screen right now?
--
--  The recruit scan's last gate (companion_scan_one), and the only thing it needs
--  from the render side: an off-screen stalker must never eat one of the limited card
--  slots. Exported rather than lending iqm_scan the two helpers behind it, because
--  those two are the hot per-card frame path and belong with the code that runs them
--  every frame -- and because the scan does not actually want an anchor point, it
--  wants a yes or a no. Runs a handful of times per frame at most, on a budgeted
--  scan, so being reached through the namespace costs nothing.
function npc_on_screen(obj)
	local wp = anchor_world_pos(obj)
	return (wp and project_world(wp)) and true or false
end

-- Line-of-sight: cast a geometry ray from the NPC's head toward the camera; if it hits
-- world geometry noticeably closer than the head, the NPC is behind cover and the card is
-- hidden. Mirrors Catspaw's HUD-marker LOS (flags 3 = Objects+Statics, ignore the NPC's
-- own body). Polled per-NPC at los_rate with a short grace window so brief occlusions
-- don't flicker. Soft dependency: without demonized_geometry_ray (e.g. vanilla Anomaly)
-- we skip the cull and the card shows whenever it's on-screen.
--   `fallback_pos` is the already-computed anchor (chest/shoulder); the head bone is
--   fetched here rather than by the caller so that per-frame pcall only happens on the
--   frames we actually cast (most frames return the cached result and touch nothing).
-- One geometry_ray is built lazily and reused for every cast: range and flags never
-- change, and the per-NPC ignore object is retargeted through the underlying engine
-- ray_pick (gr.ray:set_ignore_object, the same call the wrapper's own constructor
-- makes; geometry_ray:get reads no other per-call state). That drops the wrapper
-- table, args table and ray_pick construction from every cast. _los_dir is the
-- direction scratch, safe to reuse for the same reason _w2u/_sv are.
local _los_ray = nil
local _los_dir = vector()
local function los_cast(obj, pos, dir)
	local gr = _los_ray
	if not gr then
		gr = demonized_geometry_ray.geometry_ray({
			ray_range = 1000,
			flags     = 3,     -- 1 Objects + 2 Statics (walls, props)
		})
		_los_ray = gr
	end
	gr.ray:set_ignore_object(obj)   -- don't let the NPC's own body block the ray
	local res = gr:get(pos, dir)
	return res and res.distance
end

local function has_los(id, obj, fallback_pos, tg)
	if not C.los_check then
		if DEBUG then printf("[IQM-LOS] id=%s SHOW: los_check is OFF", id) end
		return true
	end
	if not demonized_geometry_ray then
		if DEBUG then printf("[IQM-LOS] id=%s SHOW: demonized_geometry_ray MISSING", id) end
		return true
	end
	local f = FILT[id]
	if f and f.los_next and tg < f.los_next then
		return f.los ~= false
	end
	-- Sample the head (usually visible) rather than the chest anchor, which often sits
	-- behind waist-high cover and would falsely hide a plainly-visible NPC. Only reached
	-- on a cast frame, so the pcall/bone lookup cost is paid at los_rate, not every frame.
	-- bone_position returns a fresh vector, and nothing below mutates pos, so it's used
	-- directly (no defensive copy).
	local pos = fallback_pos
	local okp, hp = pcall(obj.bone_position, obj, "bip01_head")
	if okp and hp then pos = hp end
	local cam  = device().cam_pos
	local dist = pos:distance_to(cam)
	local dir  = _los_dir:set(cam):sub(pos):normalize()

	-- Cast from the NPC anchor toward the camera. A large range (as Catspaw's marker LOS
	-- uses) makes a clear shot report a hit well BEYOND the NPC (or nothing), while a wall
	-- in between reports a hit noticeably CLOSER than the NPC. Wrapped in pcall so a ray
	-- failure can't silently leave the card showing through walls.
	local ok, hit = pcall(los_cast, obj, pos, dir)
	if not ok or hit == nil then hit = 1000 end   -- no hit / ray failed => treat as clear
	local clear = (dist - hit) < 0.5        -- occluded if something's hit closer than the sample point

	if DEBUG then
		-- printf is NOT string.format: _g.script gsubs the literal token "%s" and
		-- nothing else, so a "%.1f" here would print verbatim AND shift every later
		-- argument left by one (which is how this line used to report dist under the
		-- "clear=" label and drop hit/clear entirely). Round with the real formatter
		-- and hand printf plain %s.
		printf("[IQM-LOS] id=%s los_check=%s ray_ok=%s dist=%s hit=%s -> clear=%s",
			id, tostring(C.los_check), tostring(ok),
			string.format("%.1f", dist), string.format("%.1f", hit), tostring(clear))
	end

	if not f then return clear end
	if clear then f.los_good_t = tg end
	-- NOTE: keep this a real boolean (not nil). If it were nil, `f.los = clear or grace`
	-- becomes nil, and the cached path's `f.los ~= false` reads nil as visible, which
	-- showed the card through walls for an NPC never yet glimpsed (i.e. at first approach).
	local grace = f.los_good_t ~= nil and (tg - f.los_good_t) < C.los_grace
	f.los      = clear or grace
	-- PHASE (see PHASE_MUL). The average cast rate is fine -- eight NPCs at los_rate 150
	-- is under one ray a frame -- but the DISTRIBUTION was not: phase-locked, one frame
	-- in nine did eight head-bone pcalls plus eight 1000-unit ray_picks and the eight
	-- frames either side did none. Scattering the FIRST deadline leaves the steady state
	-- exactly as it was (every deadline after this one is tg + los_rate, so the interval
	-- is never shortened) and leaves the first cast on the frame it happens today. Only
	-- the SECOND cast moves, and only earlier, by at most one interval. The +1 stops an
	-- offset of 0 from casting again on the very next frame.
	if f.los_next then
		f.los_next = tg + C.los_rate
	else
		f.los_next = tg + 1 + ((id * PHASE_MUL) % C.los_rate)
	end
	return f.los
end

-- Framerate-independent ease toward the projected head point, with a snap for
-- big jumps and whole-pixel hysteresis so the card sits rock-steady at rest.
local function smooth_point(id, tx, ty, tg)
	local f = FILT[id]
	if not f then f = { a = 0 }; FILT[id] = f end
	if not f.rdy then
		f.x, f.y = tx, ty
		f.rx, f.ry = floor(tx + 0.5), floor(ty + 0.5)
		f.tg = tg
		f.rdy = true
		return f.rx, f.ry
	end
	local dx = tx - f.x
	local dy = ty - f.y
	if (dx * dx + dy * dy) > SNAP2 then
		f.x, f.y = tx, ty
	else
		local dt = tg - (f.tg or tg)
		if dt < 1 then dt = 1 elseif dt > 100 then dt = 100 end
		local alpha = (smooth_tau <= 0) and 1 or (1 - exp(-dt / smooth_tau))
		f.x = f.x + dx * alpha
		f.y = f.y + dy * alpha
	end
	f.tg = tg
	if abs(f.x - f.rx) >= 1 then f.rx = floor(f.x + 0.5) end
	if abs(f.y - f.ry) >= 1 then f.ry = floor(f.y + 0.5) end
	return f.rx, f.ry
end

-- Distance fade + node size share one distance (computed once by the caller from the
-- already-resolved obj, rather than each re-fetching the object and re-measuring).
--   alpha_for_dist: solid within full_dist, fading to 0 at appear_dist, gone beyond.
--   node_scale_for_dist: node_min of full size at appear_dist, growing to 1 within full_dist.
local function alpha_for_dist(d)
	if d <= full_d then return 255 end
	if d >= appear_d then return 0 end
	local span = max(0.1, appear_d - full_d)
	return floor(((appear_d - d) / span) * 255)
end

--- How much of this card the player has asked to see, 0..1, from where its anchor sits
--  relative to the crosshair. 1 (untouched) whenever focus mode is off, whenever the
--  role is exempt at the chosen mode, and everywhere inside the ring.
--
--  IT MEASURES THE ANCHOR, NOT THE PLATE. hx/hy is the head/shoulder node -- the point
--  the leader line starts from and the thing the player is actually looking at. The card
--  hangs 70 px to one side of it and flips sides near a screen edge, so measuring the
--  plate would make the same NPC focus at different head positions depending on which
--  way the card happened to be pointing.
--
--  WHY SCREEN SPACE AND NOT AN ANGLE OFF cam_dir. Both are available and they order
--  identically (screen radius is f*tan(theta) under a pinhole projection, which is
--  monotone in theta), so this is a choice about cost and about what happens at other
--  fields of view. Screen space costs NO engine call at all -- hx/hy is already in hand
--  for the draw -- where the angular form needs a device() read, a subtract, a normalise
--  and a dot per NPC. And it follows the FOV rather than fighting it: aiming down sights
--  magnifies the world into the same ring, so the cone this describes in world terms
--  tightens exactly as much as the player's view narrowed, which is what someone
--  scoping a distant figure means by "the one I am looking at".
--
--  THE KX CORRECTION IS WHAT MAKES IT A CIRCLE. The virtual UI is 4:3 and is stretched
--  to the real screen, so a raw radius in UI units draws an ellipse -- wide and squat on
--  16:9, worse on 21:9. Dividing the X delta by UI_KX puts it in the same units as the
--  Y delta, which is the same correction the leader line and the node dot already make
--  (iqm_cards.place_seg). Measured against HALF the UI's 768-unit height, which is the
--  unit iqm_beacon's centre falloff already uses -- so the two crosshair radii the menu
--  offers mean the same thing, on the same crosshair.
--
--  IT IS THE INVERSE OF THAT FALLOFF, and the pair is deliberate. ctr_fade FADES a marker
--  as it nears the crosshair (get out of the way of what is being looked at); this REVEALS
--  a card there (it is what is being asked about). Not shared code: the overlap is a divide
--  and a magnitude, the two sit in different modules on different subjects, and the shapes
--  differ for reasons of their own -- ctr_fade smoothsteps in space because it is a static
--  function of position with no temporal ease behind it, while this eases in TIME through
--  f.fa and so takes the plain linear ramp alpha_for_dist uses.
--  See docs/decisions.md#focus_mode.
local function focus_factor(hx, hy, role)
	if not (FOC.on and hx) then return 1 end
	-- Exempt roles never dim. `or 9` matches slot_order_cmp's reading of an unknown role:
	-- a role missing from ROLE_PRIO ranks last, and here it is likewise treated as the
	-- least protected rather than as the most.
	if (ROLE_PRIO[role] or 9) <= FOC.prio then return 1 end
	local dx, dy = (hx - 512) * FOC.kxi, hy - 384
	local d2 = dx * dx + dy * dy
	if d2 <= FOC.ri2 then return 1 end
	if d2 >= FOC.r2  then return FOC.floor end
	-- Only the handful of cards actually IN the soft edge pay the sqrt; the two common
	-- answers (solid inside, floor outside) are settled on the squares. Linear in
	-- distance rather than in its square, so the ramp matches alpha_for_dist's.
	local t = (FOC.r - sqrt(d2)) / max(0.1, FOC.r - FOC.ri)
	return FOC.floor + (1 - FOC.floor) * t
end
--- PUBLISHED for the focus harness, and for nothing else -- render() calls the local.
--  A pure function of (point, role) and the mirrors, which is exactly the shape worth
--  testing offline: the alternative was a harness that transcribed the geometry and then
--  agreed with its own copy of it. Under a different name because inside a .script the
--  globals ARE the namespace, so `focus_factor = focus_factor` would assign the local to
--  itself and publish nothing. Reaching the mirrors it reads is a debug.getupvalue away
--  from here; the harness does exactly that rather than needing FOC published too.
card_focus = focus_factor

local function node_scale_for_dist(d)
	if d <= full_d then return 1 end
	if d >= appear_d then return node_min end
	local span = max(0.1, appear_d - full_d)
	return node_min + (1 - node_min) * ((appear_d - d) / span)
end

-- Header text is fixed per role, so translate once and cache (game.translate_string is a
-- string-table lookup we were paying every frame). Cache cleared on config/language change.
local HDR_KEYS = {
	target = "st_iqm_hdr_target",  guide  = "st_iqm_hdr_guide",   companion = "st_iqm_hdr_companion",
	-- DELIVER TO, not REPORT BACK (R2.55). header_for falls back to st_iqm_hdr_target for
	-- any unlisted role, so omitting this line would not error -- it would quietly print
	-- "REPORT BACK" over a job that is not finished, which is the exact bug the delivery
	-- role exists to fix. A silent-fallback table needs its entries stated, not inferred.
	delivery = "st_iqm_hdr_delivery",
	hire   = "st_iqm_hdr_hire",
	guider = "st_iqm_hdr_guider",  trader = "st_iqm_hdr_trader", mechanic = "st_iqm_hdr_mechanic",
	barman = "st_iqm_hdr_barman",  medic = "st_iqm_hdr_medic",   important = "st_iqm_hdr_important",
	work   = "st_iqm_hdr_work",
}
-- "work" cards refine the plain HIRING header with the classified job kind
-- (iqm_taskwork.work_kind, read per entry in update()). Unlisted kinds fall
-- back to the plain header.
local WORK_HDR = {
	fetch   = "st_iqm_hdr_work_fetch",   hunt    = "st_iqm_hdr_work_hunt",
	assault = "st_iqm_hdr_work_assault", bounty  = "st_iqm_hdr_work_bounty",
	rescue  = "st_iqm_hdr_work_rescue",  courier = "st_iqm_hdr_work_courier",
	artifact = "st_iqm_hdr_work_artifact", escort = "st_iqm_hdr_work_escort",
	repairs = "st_iqm_hdr_work_repairs",
	gear    = "st_iqm_hdr_work_gear",    parts   = "st_iqm_hdr_work_parts",
	patches = "st_iqm_hdr_work_patches", recover = "st_iqm_hdr_work_recover",
	money   = "st_iqm_hdr_work_money",   survey  = "st_iqm_hdr_work_survey",
	special = "st_iqm_hdr_work_special",
}
-- `key` overrides the role's default header string id (work-kind refinement);
-- translations cache by string id either way.
local function header_for(role, key)
	key = key or HDR_KEYS[role] or "st_iqm_hdr_target"
	local h = _hdr_cache[key]
	if not h then
		h = game.translate_string(key)
		_hdr_cache[key] = h
	end
	return h
end

-- Role glyph for the ambient cards. Bundled with the mod (see iqm_textures.xml /
-- iqm_roles.dds), so the role cards are self-contained; no other mod needed.
local ROLE_ICONS = {
	trader = "iqm_role_trader", mechanic = "iqm_role_mechanic",
	barman = "iqm_role_barman", medic    = "iqm_role_medic",
	guider = "iqm_role_guide",  important = "iqm_role_important",
	work   = "iqm_role_work",
}
local function icon_for(role)
	if C.role_style == 0 then return end   -- text-only style
	return ROLE_ICONS[role]
end

-- Faction palette + emblems, ported straight from the gamma-db header
-- (site/js/constants.js FACTION_COLORS / FACTION_ICONS), keyed by the bare
-- community string character_community returns. Drive the two faction options:
-- faction_colors tints the card to the NPC's faction colour; faction_icons puts
-- the faction emblem on STATE cards (which carry no role glyph). An unlisted
-- community (monster/trader/actor, etc.) has no entry, so both options fall back
-- to the default gold accent / no emblem for it.
local FACTION_RGB = {
	stalker  = {212, 168,  67}, bandit   = {181, 160, 104}, dolg     = {196, 112,  96},
	freedom  = { 95, 191,  95}, csky     = { 91, 164, 207}, ecolog   = {127, 191,  95},
	killer   = { 74, 144, 217}, army     = {107, 142,  90}, monolith = {160, 128, 192},
	renegade = {200, 120,  64}, greh     = {139,  74, 139}, isg      = {122, 139, 106},
	zombied  = {154, 160,  90},
}

-- The three keys that mean REPORT BACK, across all three of the vocabularies that reach
-- BEACON_RGB: the `target` ROLE, and the `handin` / `delivery` KINDS. Mode 2's faction
-- override is a turn-in rule and this is what "a turn-in" means -- one list, so the rule
-- cannot be applied to two of them and forgotten on the third.
-- `delivery` costs nothing on the ROLE path (it has never been keyed in beacon_roles, so
-- it cannot reach it) and is listed anyway, because what this table states is what the
-- key MEANS, not which path happens to draw it today.
local TURN_IN = { target = true, handin = true, delivery = true }

-- ...and the keys that are NOT a theme at all, and so do not follow beacon_color (R2.63a).
--
-- Every other entry in BEACON_RGB is a MIRROR: it is the colour that key's PDA map spot
-- carries, and beacon_color is the player's choice about whether to wear the map's colours
-- or the theme's. These two are not mirrors of anything the player can turn off -- they are
-- the task KIND speaking, and the kind is a fact about the objective rather than a style.
-- The map has no unselected twin that could disagree with them either: no ROLE draws a
-- skull or a red reticle, so a mutant hunt and a bounty can never stand beside a
-- differently-coloured mark meaning the same thing -- which is the entire defect the mode
-- gate exists to prevent, and it cannot arise here.
--
-- THE BOUNTY IS WHY THIS IS A BUG AND NOT A PREFERENCE. It is deliberately not keyed in
-- BEACON_ICON -- 'a bounty IS the ordinary go-find-it reticle and only its colour differs'
-- -- so gating its red on the mode does not dim the mark, it DELETES it: in mode 0, the
-- shipped default, the marker became glyph-for-glyph and byte-for-byte an ordinary
-- objective. R2.63 shipped that for the length of one review by routing every key through
-- the new gate, having argued in its own proposal that these two must not be. mode 3's
-- note in iqm_cards had said so in writing since R2.62 ('a selected mutant hunt keeps its
-- lime reticle') and was quietly made false by the same edit.
local DRESSING = { mutant = true, bounty = true }

--- The ONE answer to "what colour is this marker", for every path that draws one.
--
--  `key` is a ROLE or a task KIND -- they share BEACON_RGB's namespace by design, and the
--  sharing is what makes a single resolver possible. `fcomm` is the NPC's community where
--  the caller knows it, nil where it does not (a task target too far to be tracked has no
--  entry); mode 2's fallback covers that and is the same one the role path always took.
--
--  nil OUT MEANS THE ACCENT, and it is the answer for mode 0, for mode 3 (draw_beacon
--  substitutes beacon_r/g/b wherever it would reach for the accent, so the mode needs
--  nothing resolved per marker), and for every key the palette has no entry for. So the
--  accent stays the thing that draws when nothing better is known, never a black marker.
--  EXCEPT for the two DRESSING keys, which are not the theme's to choose and answer the
--  same colour in all four modes -- read that note before touching this one.
--  The test is `== 1 or == 2` and NOT `> 0`: a greater-than hands mode 3 the map's colours
--  as well, i.e. quietly makes it mode 1 wearing a custom fallback.
--
--  WHY IT EXISTS (R2.63). Three paths draw markers -- the role pass below, offer_task and
--  offer_party -- and each resolved its own colour. Two of them gated on the mode and one
--  did not, so a selected hand-in wore the map's green in the mode whose whole promise is
--  "everything is the accent", standing beside an unselected hand-in wearing the accent:
--  same glyph, same meaning, two colours, and the difference encoding something colour is
--  not allowed to encode here (see BEACON_RING). The fix is not a fourth test in the third
--  path -- it is that there is one resolver and no path is permitted a private copy.
--  offer_party's copy was CORRECT and went too: a private copy that happens to agree is
--  the same hazard as one that does not, one edit later.
local function beacon_tint(key, fcomm)
	-- The kind dressing first and unconditionally: it is not what beacon_color chooses
	-- between (see DRESSING), and for the bounty the colour is the whole mark.
	if DRESSING[key] then return BEACON_RGB[key] end
	local bm = C.beacon_color
	if bm ~= 1 and bm ~= 2 then return nil end
	-- A turn-in in mode 2 is ALWAYS a faction colour, never the green: a quest giver whose
	-- community has no FACTION_RGB entry takes STALKER's. That is aimed at the script
	-- traders, which report the community "trader" -- the loners' amber is the right read
	-- for a neutral shopkeeper, and it keeps the mode honest, since a turn-in that fell
	-- back to green would look like a faction colour the player could not place rather
	-- than like a fallback.
	if bm == 2 and TURN_IN[key] then
		-- nil IS NOT false HERE, and collapsing them was a bug for the length of one review
		-- (R2.63b). `false` means the community was LOOKED UP and is not one this palette
		-- knows -- the script traders, which report "trader" -- and the amber above is the
		-- deliberate answer to that. `nil` means NOBODY HAS LOOKED: the selected task's
		-- giver is outside the scan's reach, so there is no tracked entry to hold a
		-- community. Answering amber there states a faction, and the state it states is
		-- wrong -- a Duty giver drew loner amber at 150 m and snapped to Duty red on
		-- crossing beacon_dist, which is this option's colour becoming a function of RANGE.
		-- The turn-in green is the honest answer instead: it is mode 1's, the base this mode
		-- layers on, and it claims only what is actually known -- that this is a turn-in.
		-- The mark still changes when the giver comes into range, and that is information
		-- ARRIVING rather than a wrong claim being corrected.
		if fcomm == nil then return BEACON_RGB[key] end
		-- `false` indexes a table legally and finds nothing, so the unlisted case falls to
		-- the amber without a second test.
		return FACTION_RGB[fcomm] or FACTION_RGB.stalker
	end
	-- Mode 2 LAYERS on mode 1 rather than replacing it: only the turn-in takes the faction
	-- colour. A medic has no meaningful faction identity -- being a medic IS the identity
	-- -- so the services keep their map colour in both modes.
	return BEACON_RGB[key]
end

--- The marker tint resolver, published for iqm_beacon (R2.63).
--
--  The two offers that live over there -- the selected task's and the party's -- have to
--  reach the SAME resolver the role pass uses, because "one rule, no private copies" is
--  the entire point of it having been extracted (see beacon_tint). It crosses the seam
--  in this direction rather than the colours crossing in the other because the function
--  that would have called it here, actor_on_update, is at exactly LuaJIT's 60 upvalues:
--  one more and the file does not compile, which takes every feature down together --
--  the same cliff that split this module in the first place. So iqm_beacon binds it in
--  its own apply_config, where there is room, and this side passes only the inputs it
--  alone holds (the giver's community, off the tracked entry).
--
--  The FUNCTION crosses, not its answer, and it reads C and FACTION_RGB as upvalues on
--  this side -- so the caller cannot get a stale rule the way a bound colour would go
--  stale: read_config mutates C and never replaces it, the same contract config() has.
function tint()
	return beacon_tint
end
-- These reference the GAME's own PDA faction patches, not a bundled atlas: the
-- texture ids are registered by G.A.M.M.A. UI's ui_mm_faction_patches (a mandatory
-- GAMMA component, so always present), and HD Faction Patches transparently
-- overrides them at higher resolution when installed. So the emblem on the card is
-- exactly the patch the player sees on the faction-relations screen. There is no
-- game patch for zombied (never a markable community anyway), so it gets no emblem.
local FACTION_TEX = {
	stalker  = "ui_mm_faction_stalker",  bandit   = "ui_mm_faction_bandit",  dolg     = "ui_mm_faction_dolg",
	freedom  = "ui_mm_faction_freedom",  csky     = "ui_mm_faction_csky",    ecolog   = "ui_mm_faction_ecolog",
	killer   = "ui_mm_faction_killer",   army     = "ui_mm_faction_army",    monolith = "ui_mm_faction_monolith",
	renegade = "ui_mm_faction_renegade", greh     = "ui_mm_faction_greh",    isg      = "ui_mm_faction_isg",
}

--- The faction emblem table, for iqm_cards' interference pass, which needs a pool of emblems
--  to swap a corrupted one out of. The list stays here, next to the resolver that reads it,
--  and is handed over BY REFERENCE -- a second copy of these twelve strings in iqm_cards is
--  the shape of the R2.56 mirror failure: two lists with one meaning and no eye on the
--  slower half.
--
--  The caller must NOT write to it. It is the live lookup for every faction card on screen.
--
--  IT HAS TO SIT BELOW THE TABLE, and it shipped above it for one revision (R2.59b) doing
--  nothing at all. A Lua local is in scope only from its own declaration ONWARD, so an
--  accessor written 600 lines earlier reads `FACTION_TEX` as this module's NAMESPACE key,
--  which is nil. It returned nil, iqm_cards' `if ft then` guard skipped, FACT_POOL stayed
--  empty, and corrupt_icon's own `n < 2` guard then returned the true glyph -- three soft
--  guards in a row turning a scope error into a feature that silently did not exist. Role
--  glyphs flickered and faction emblems never did, which is how it was found: by eye, in
--  game, because nothing anywhere errored.
--
--  This is the third time in this file's history: shape_box shipped with `sqrt` resolving to
--  a global nil for sitting above the math locals, and `project_off = project_off` was a
--  silent no-op for the same scope rule. Declaration order is not a style question here.
function faction_tex()
	return FACTION_TEX
end

-- Rank abbreviations (option: short_ranks). Generated Duty/Military stalkers are
-- named "<rank> <surname>" from the game's name tables, and the rank prefix
-- ("Senior Sergeant", "Junior Lieutenant", ...) can be longer than the surname,
-- blowing out the card width. Abbreviate just the LEADING rank. Ordered
-- longest-phrase first so a multi-word rank wins over its own components
-- ("Senior Sergeant" before "Sergeant", "Lieutenant Colonel" before either word);
-- the first prefix hit wins and returns.
local RANK_ABBR = {
	{ "Lieutenant Colonel", "Lt Col"  }, { "Lieutenant General", "Lt Gen"  },
	{ "Colonel General",    "Col Gen" }, { "Major General",      "Maj Gen" },
	{ "Senior Sergeant",    "Snr Sgt" }, { "Junior Sergeant",    "Jr Sgt"  },
	{ "Master Sergeant",    "Mstr Sgt"}, { "Staff Sergeant",     "SSgt"    },
	{ "Sergeant Major",     "Sgt Maj" }, { "Senior Lieutenant",  "Snr Lt"  },
	{ "Junior Lieutenant",  "Jr Lt"   }, { "Senior Private",     "Snr Pte" },
	{ "Warrant Officer",    "WO"      }, { "Sergeant",           "Sgt"     },
	{ "Lieutenant",         "Lt"      }, { "Corporal",           "Cpl"     },
	{ "Private",            "Pte"     }, { "Captain",            "Capt"    },
	{ "Colonel",            "Col"     }, { "General",            "Gen"     },
	{ "Major",              "Maj"     }, { "Ensign",             "Ens"     },
}
local function shorten_rank(n)
	for i = 1, #RANK_ABBR do
		local full = RANK_ABBR[i][1]
		local lf   = #full
		if n:sub(1, lf) == full then
			local nxt = n:byte(lf + 1)
			if nxt == nil then return RANK_ABBR[i][2] end             -- name is only the rank
			if nxt == 32  then return RANK_ABBR[i][2] .. n:sub(lf + 1) end  -- "<rank> <surname>"
		end
	end
	return n
end

-- NPC display name from an already-resolved object (name is stable, so the caller caches
-- the result on the tracked entry and only calls this once per NPC).
local function name_from_obj(obj)
	if not obj then return "" end
	local n = obj:character_name()
	if n == nil or n == "" then n = obj:name() end
	n = n or ""
	if C.short_ranks and n ~= "" then n = shorten_rank(n) end
	return n
end

-- Card roles come in two grammars: STATE roles (something to act on right now;
-- verb-phrase header, chirps on sighting) and AMBIENT roles (a standing fact about
-- the NPC; noun header, role glyph, silent). This is the STATE half. It stayed here
-- rather than going to iqm_scan with ROLE_PRIO because chirping is a property of the
-- CARD, not of the detection: the scan has no opinion about sound.
-- `delivery` joins them (R2.55) for the same reason target is here: it is an objective
-- NPC of a live task, something to act on now, and the two differ only in which end of
-- the errand you are at.
local CHIRP_ROLES = { target = true, delivery = true, guide = true, companion = true, hire = true }

-- Subtle 2D PDA chirp when a card first comes into view. The sound_object is created
-- lazily and cached; guarded so a missing sound (or an odd engine state) never errors.
local function play_chirp()
	if not (C.sound_alert and sound_object) then return end
	local ok = pcall(function()
		if not _chirp_snd then _chirp_snd = sound_object(SOUND_PATH) end
		if _chirp_snd then
			-- volume is a property, set AFTER play (the pattern working sound mods use);
			-- there is no set_volume method.
			_chirp_snd:play(db.actor, 0, sound_object.s2d)
			_chirp_snd.volume = C.sound_vol
		end
	end)
	if DEBUG then printf("[IQM-SND] play '%s' ok=%s handle=%s", SOUND_PATH, tostring(ok), tostring(_chirp_snd)) end
	if not ok then _chirp_snd = nil end   -- drop a bad handle so we can retry later
end

-- True while the fullscreen PDA (map / tasks / contacts) is open, so the world overlay
-- hides instead of floating over the menu. The menu handle is stable once built, so it's
-- cached after the first successful lookup (only IsShown is polled per frame thereafter).
-- The BOUND METHOD is cached alongside the handle. `_pda_menu.IsShown` is a luabind
-- __index on the menu's class table, which is a C++ round-trip of its own before the
-- call it is looking up -- paid once here instead of once a frame. It is dropped on
-- exactly the path that drops the handle, so the two can never disagree about which
-- menu the method belongs to.
local _pda_menu, _pda_shown = nil, nil
local function pda_is_open()
	if not _pda_menu then
		if not (ActorMenu and ActorMenu.get_pda_menu) then return false end
		local ok, m = pcall(ActorMenu.get_pda_menu)
		if not ok or not m then return false end
		_pda_menu, _pda_shown = m, m.IsShown
	end
	local ok, shown = pcall(_pda_shown, _pda_menu)
	if not ok then _pda_menu, _pda_shown = nil, nil; return false end   -- stale handle: re-fetch next frame
	return shown or false
end

-- True while the main HUD is on screen. Anything that takes the HUD away -- the
-- console `hud_draw 0`, _g.show_indicators(false) / level.hide_indicators_safe(),
-- an open inventory, an NPC dialog, or any script UI registered with Register_UI --
-- has to take the cards with it, so a mod hiding the HUD is respected without IQM
-- knowing that mod exists. main_hud_shown() is base _g.script and is the same gate
-- the rest of GAMMA's HUD mods (compass, subtitles, status icons, hudmarks) use.
--
-- The one clause we deliberately override: main_hud_shown() also reports false while
-- a scope or the binoculars are zoomed. These cards are world-space labels pinned to
-- NPCs, and glassing a distant stalker is exactly when you want to read one, so the
-- zoom is allowed back in -- the same carve-out Catspaw's hudmarks make. A HUD that
-- is genuinely hidden still wins: the two causes that can coexist with a zoom
-- (hud_draw and hide_indicators) are re-tested by hand. The rest can't -- opening the
-- inventory / PDA / a dialog drops the zoom first.
--
-- Don't be tempted to cache hud_draw off the on_console_execute callback: that callback
-- only fires from _g.exec_console_cmd(), so it misses both a player typing in the
-- console and mods that call get_console():execute() directly (GAMMA's Seraphim
-- death-save in perk_based_artefacts does exactly that). A stale cache would leave
-- cards floating over a blacked-out screen. Base main_hud_shown() queries live for the
-- same reason.
local function hud_is_shown()
	-- Zoom tested first: main_hud_shown() queries hud_draw (a console-map lookup, ~530
	-- entries compared by xr_strcmp) BEFORE its own two zoom clauses, so asking it while
	-- zoomed pays for that lookup and then always answers false. Branching here keeps the
	-- frame at one console query instead of two, in the middle of aiming.
	if axr.binoc_is_zoomed or axr.scoped_weapon_is_zoomed then
		return _HUD_STATE and get_console_cmd(1, "hud_draw")
	end
	return hud_shown_fn()
end

-- --------------------------------------------------------------------------
-- Reveal hotkey
-- --------------------------------------------------------------------------
-- Four modes (C.reveal_mode). 0/1/2 mirror MCM's own activation modes (press,
-- double-tap, long-press) and all toggle, differing only in the gesture MCM detects.
-- 3 is hold-to-show: the cards are up only while the key is physically down. MCM has
-- no helper for that -- its key_hold is a long press that fires once, which is mode 2.
-- "Always shown" is deliberately not a mode: an unbound key (-1) means always shown, so
-- a half-configured menu can never leave you with no cards and no way to get them back.
--
-- Hold mode polls key_state() -- the engine's live physical key state -- rather than
-- latching a flag off on_key_press/on_key_release. Those two callbacks are gated on
-- KEYS_UNLOCK (bind_stalker_ext), which goes false the moment a scripted GUI opens, so
-- a release pressed "through" a UI opening is simply never delivered and a latched flag
-- would leave the cards stuck on until the key was pressed again. Polling is
-- self-correcting, and we're already on a per-frame path, so it costs one engine call.
-- on_key_hold is NOT KEYS_UNLOCK-gated, which is why the long-press mode can use it.
--- Is `key` (with its required modifier) physically down this instant?
--
--  Extracted from reveal_visible's hold branch at R2.58, when the summon envelope became
--  the second caller: two live pollers of the same engine call, written twice, would
--  disagree about the nil cases the moment either was touched.
--
--  key_state is BOOL-typed in the engine, so it currently arrives as 0/1; the "or 0" form
--  also reads correctly if it is ever exported as a real boolean (false would otherwise
--  pass a bare ~= 0 test). Same guard MCM itself uses.
--
--  get_mod_key polls the modifier keys the same way; with old MCM (no keybind support)
--  there is no modifier option to honour, so the key alone is enough.
--
--  DOES NOT GUARD key_state_fn ITSELF. Both callers have to answer "there is no poll on
--  this exe" with their own never-strand default -- true, meaning "show it" -- and a guard
--  here could only return false, which is the one answer neither of them wants.
local function key_is_down(key, mod)
	if (key_state_fn(key) or 0) == 0 then return false end
	return (not mcm_keybinds) or ui_mcm.get_mod_key(mod)
end

local function reveal_visible()
	local key = C.reveal_key
	if key < 0 then return true end

	if C.reveal_mode == 3 then
		if not key_state_fn then return true end   -- no engine poll: don't hide with no way back
		return key_is_down(key, C.reveal_mod)
	end
	return reveal_on
end

local function toggle_reveal()
	reveal_on = not reveal_on
end

--- Does the ground route WANT to be up this frame, before the fade is applied? The target
--  the envelope eases toward (see SMN); `tg` is the frame clock.
--
--  The three modes and the one rule that outranks all of them:
--
--    0 always     -- the route ignores the hotkey entirely (it still takes the PDA and
--                    HUD gates, which are not this function's business).
--    1 cards      -- whatever the nameplates are doing. Identical to pre-R2.58.
--    2 summoned   -- held, or inside the dwell window after a release.
--
--  NO KEY, NO GATE. An unbound key means "always drawn", the same never-strand rule
--  reveal_visible applies for the same reason: a half-configured menu must not be able to
--  leave a player with no route and no gesture that brings one back. That is why
--  route_key's -1 means "fall back to the nameplate key" and NOT "off" -- with both
--  unbound there is no gesture anywhere and the answer is simply yes.
--
--  THE RELEASE EDGE, not the release callback. `down` is last frame's poll, so the dwell
--  is stamped by comparing two polls -- which is what makes a TAP work at all (the key is
--  already up by the time anything could react to it) and what makes the whole gesture
--  independent of KEYS_UNLOCK. See the note on SMN.
local function route_wanted(tg)
	local m = C.route_reveal
	if m == 0 then return true end
	if m == 1 then return reveal_visible() and true or false end

	local key, mod = C.route_key, C.route_mod
	if key < 0 then key, mod = C.reveal_key, C.reveal_mod end
	if key < 0 then return true end            -- no gesture exists anywhere
	if not key_state_fn then return true end   -- no engine poll: don't hide with no way back

	if key_is_down(key, mod) then
		SMN.down, SMN.till = true, 0
		return true
	end
	if SMN.down then                           -- ...and this is the frame it came up
		SMN.down = false
		SMN.till = tg + SMN.dwell
	end
	return tg < SMN.till
end

-- --------------------------------------------------------------------------
-- Public: what the route driver (iqm_nav) needs from here
-- --------------------------------------------------------------------------
-- Two accessors and nothing else. The route is drawn by iqm_nav out of world
-- points from iqm_route, none of which belongs in this file; what does belong
-- here is WHO the objective NPC is and WHETHER the mod's overlays are showing
-- at all, because both are already decided above and would otherwise be
-- reimplemented (differently, and then wrongly) over there.

--- Whether the mod's overlays are visible at all right now: the same three gates
--  render() applies to every card and beacon -- fullscreen PDA, main HUD, reveal
--  hotkey. The driver blanks the ribbon on this rather than dropping the route,
--  so letting go of the reveal key brings it back with no re-search.
--
--  MEMOISED PER FRAME, because there are two askers and the answer is not cheap. The
--  three primitives together are four or five engine crossings -- a pcall and a luabind
--  __index for the PDA's IsShown, and main_hud_shown() reading _HUD_STATE,
--  actor_menu.last_mode, pda.dialog_closed, a next() over _GUIs and a console lookup for
--  hud_draw -- and this file's render() and iqm_nav's driver each want the answer once
--  per frame. time_global is the frame clock (Device.dwTimeGlobal, stepped once a frame),
--  so keying on it is exactly "once per frame" with no invalidation to get wrong: a stale
--  entry cannot outlive the frame that made it.
--
--  LAZY, filled by whichever asker comes first, NOT pushed from actor_on_update. render()
--  has early returns above the gate, so a push from there would leave the memo cold on
--  precisely the frames it is wanted; and iqm_core's actor_on_update is registered before
--  iqm_nav's, so the first ask is ours anyway.
--
--  `tg` is optional and is only ever passed by our own frame path, which already has it.
--  Every other caller (iqm_nav) asks with no argument and pays one time_global.
--  TWO ANSWERS OUT OF ONE MEMO since R2.58, and the split is what makes the summon
--  possible rather than being tidiness. `b` is the pair of gates that are about whether
--  the game is showing the world at all -- PDA down, HUD up -- and `v` is that plus the
--  nameplates' own reveal rule. The route rides `b` and its own envelope, so it can be
--  summoned while the nameplates are toggled OFF, which is the case the feature exists
--  for. Both are filled by the one call, so the engine crossings above are still paid for
--  once a frame however many of the two answers get asked for.
local OVIS = { tg = nil, v = false, b = false }
function overlay_visible(tg)
	local now = tg or (time_global and time_global() or 0)
	if OVIS.tg == now then return OVIS.v end
	-- Stored raw, not coerced to a boolean: this is the same expression the callers used
	-- to evaluate inline, and the memo must not change what it answers with. The
	-- short-circuit is unchanged too -- reveal_visible is still not asked on a frame the
	-- world is not being drawn.
	local b = (not pda_is_open()) and hud_is_shown()
	local v = b and reveal_visible()
	OVIS.tg, OVIS.b, OVIS.v = now, b, v
	return v
end

--- The GROUND ROUTE's alpha multiplier this frame: 0..1, or 0 for "not drawn at all".
--
--  The route's counterpart to overlay_visible, and the one number both consumers of the
--  summon read -- this file's draw at the foot of render(), and iqm_nav, which uses `> 0`
--  to decide whether the drawing half of its tick is worth running (six occlusion rays, a
--  chevron refill and the lead-in, every frame, for a line nobody has asked for).
--
--  FOLDS IN THE VIEW'S OWN SWITCHES, mark_route and the world2ui probe, because they are
--  this file's config and the ground line is this file's view: iqm_nav publishes for the
--  minimap as well, and a driver that had to test our options to find out whether we were
--  drawing would be reimplementing the seam the wrong way round.
--
--  Does NOT ease anything. The envelope is stepped once a frame in render(), where the
--  frame delta is; this reports it, so two callers in one frame cannot advance it twice.
function route_alpha(tg)
	if not (C.mark_route and w2u_ok) then return 0 end
	overlay_visible(tg)          -- fills OVIS.b for this frame (memoised; see above)
	if not OVIS.b then return 0 end
	return SMN.a
end


--- Retint the live route, for the F7 colour cycler. The route's colour moved to
--  iqm_cards with the rest of its look at R2.45; this forwards, because the entry
--  point is typed into a console by hand ("iqm_core.route_tint(200,90,60)") and
--  silently moving one of those is worse than a one-line hop.
function route_tint(r, g, b)
	return iqm_cards.route_tint(r, g, b)
end

--- The NPC the ground route should lead to: the nearest tracked objective, or
--  nil. Only role "target" -- the hand-in / talk-to / delivery NPC -- because one
--  ribbon can be up at a time and a path that swings between a quest giver and a
--  mechanic as you cross a hub reads as a bug rather than a feature.
--
--  Nearest rather than most-recent: with several tasks live the near one is both
--  the one you can act on and the one whose route is short enough to be legible.
--  Everything else the driver needs (range band, visibility, when to redraw) is
--  its own business; this deliberately applies no distance rule of its own.
--- The object the SELECTED task's marker sits on, or nil.
--
--  Selection is engine-side: CMapLocation compares each task location against
--  GameTaskManager().ActiveTask() to decide which spot shows its static_border
--  (map_location.cpp:376) -- which is the bracket you see around the chosen marker. There
--  is no "get the active task" binding, but there is `is_active_task`, so the task manager's
--  own list is walked and each candidate asked.
--
--  `current_target` is the object id the task's marker is placed on
--  (task_objects.script:117 sets it, :151 spots it), which is exactly the thing the player
--  is looking at on the map. It is frequently OFFLINE -- it is wherever the objective is,
--  not wherever you are -- so callers must not assume level.object_by_id will resolve it.
--
--  PUBLIC rather than a file-local on purpose: this module sits at 180 of the engine's 198
--  locals and a new top-level local is a cost the budget cannot really spare.
--  SECOND RETURN: is that marker on the person you report back to, rather than on the
--  thing you still have to go and do (iqm_scan.talk_to -- R2.47). Returned rather than
--  applied, because the two callers want different things out of one walk of this list:
--  the ROUTE follows the selection whatever stage it is at, since a path along the ground
--  is navigation; the MARKER can be gated on it, since an exact position through a wall
--  is a reveal. Gating here would quietly gate the route too.
--  THIRD RETURN: what KIND of job it is -- "mutant", "bounty" or nil (R2.48), from
--  iqm_scan.task_kind, which picks the marker's glyph and tint. Already nil once the
--  objective is done, since task_kind carries the same hand-in gate the second return
--  reports; so the two are consistent by construction rather than by the caller
--  remembering to check both. nil for every task that is neither, which is most of them
--  and is the case the beacon's existing reticle already covers.
function active_task_target()
	local tm = task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
	local ti = tm and tm.task_info
	local act = db.actor
	if not (ti and act and act.is_active_task) then return nil end
	for _, t in pairs(ti) do
		if t and t.current_target and t.t and act:is_active_task(t.t) then
			return t.current_target, (not scan_talk_to) or scan_talk_to(t),
			       scan_task_kind and scan_task_kind(t) or nil
		end
	end
	return nil
end

--- The NPC or place the route should lead to, or nil.
--
--  The SELECTED task's marker wins, so the route agrees with the bracket on the map: a line
--  leading somewhere other than the marker the player chose reads as a bug however
--  defensible the choice was. Both views follow it -- the ground line and the minimap trail
--  are two views of one search.
--
--  Falls back to the nearest tracked objective NPC (role "target" -- the hand-in /
--  talk-to / delivery NPC) when no task is selected or the selected one has no target
--  object. Nearest rather than most-recent: with several live it is both the one you can
--  act on and the one whose route is short enough to be legible.
function route_target()
	if not (C.enabled and C.mark_targets and db.actor) then return nil end
	local sel = active_task_target()
	if sel then return sel end
	local apos, best, best_d2 = db.actor:position(), nil, nil
	for id, t in pairs(tracked) do
		-- ...and `delivery`, which was part of `target` until R2.55. Splitting the role
		-- would otherwise have quietly dropped deliver-to NPCs out of the ground route
		-- entirely -- the kind of regression a rename makes invisible, since nothing here
		-- errors on a role it has never heard of.
		if t.role == "target" or t.role == "delivery" then
			local obj = get_obj(id)
			if obj and obj:alive() then
				local d2 = obj:position():distance_to_sqr(apos)
				if not best_d2 or d2 < best_d2 then best, best_d2 = id, d2 end
			end
		end
	end
	return best
end

-- NOTE there is deliberately no "find a nearby object for iqm_minimap to measure" helper
-- here any more. Three versions of one existed -- nearest carded NPC, then nearest online
-- object, each widening the net -- and all of them shared the defect that the trail could
-- not calibrate with nothing around. iqm_minimap now measures off the ACTOR's own map spot,
-- which is always present and always on the minimap, so no such search is needed at all.

--- Where the route should lead: id, world position, whether that object is ONLINE, and
--  the navmesh vertex it believes it stands on.
--
--  iqm_nav used to resolve the id itself with level.object_by_id and drop anything that
--  failed, which was right while the target was always a tracked NPC and is wrong now that
--  it can be a task marker halfway across the level. An offline target still has an alife
--  position, and that position is all a path needs.
--
--  The LEVEL VERTEX is the fourth return because a POSITION is not always the better of
--  the two. A player-placed waypoint dropped on the PDA map (Personal Adjustable Waypoint
--  and anything else riding on_map_right_click) is born from a click on a 2D map, so its
--  y is invented -- but the exe hands the placing mod a level vertex alongside it, and
--  that one is not. iqm_nav prefers the position and falls back to this only when the
--  position turns out to be off the mesh.
--
--  Returns nil for a target on ANOTHER LEVEL. There is no navmesh path to one, so a route
--  cannot be drawn and the search must not be started.
--
--  THROTTLED, because iqm_nav asks EVERY FRAME and the answer changes at walking pace.
--  One call walks task_manager.task_info, asks the engine `is_active_task` once per live
--  task, and on the fallback path walks `tracked` measuring each entry -- then goal_pos
--  adds an alife() lookup and a game_graph() level test. On a full GAMMA save that is a
--  dozen engine round-trips per frame for a position that moves a few centimetres between
--  them. Resolved at ~5 Hz instead and the tuple handed back in between.
--
--  200 ms IS INSIDE EVERY TOLERANCE THE CONSUMERS HAVE. iqm_nav repaths when the goal has
--  drifted more than GOAL_TOL (3 m) and no more often than REPATH_MIN (700 ms), so a
--  fifth of a second of a walking target -- under 30 cm -- cannot change a single one of
--  its decisions. The one thing a timer alone would get wrong is a target that appears or
--  changes rather than moves, which is what route_goal_reset below exists for.
--
--  THE nil IS CACHED TOO. Answering "no objective" is the expensive walk finding nothing,
--  which is the common case (no task selected, nothing tracked) and so the case worth
--  not repeating. It is safe only because every way an objective can COME INTO EXISTENCE
--  goes through a reset: a new tracked entry, a role change, a config change, a level
--  change. Without those hooks a cached nil would hold a fresh quest out for up to 200 ms.
local GOALC = { ttl = 200, tg = nil, id = nil, pos = nil, online = nil, lvid = nil }

--- goal_pos's OFFLINE answers, per id. See goal_pos below for why only that half is
--  cached; declared up here because route_goal_reset is the hook that clears it and a
--  local has to exist before the function that closes over it.
--
--  `e[id]` is reused in place once created, so a steady offline target allocates nothing
--  after its first resolve. `lname` is level.name(), which cannot change without a level
--  load and so is read once per reset rather than once per resolution.
local OFFC = { ttl = 250, lname = nil, e = {} }

--- Drop the cached goal so the next ask re-resolves.
--
--  PUBLIC so the rest of the module -- and, if it ever needs to, another module -- can
--  say "the answer may have changed" without knowing what the answer was. Called from
--  every place that can change WHICH object the route should lead to, as opposed to
--  where that object is standing: the tracked set changing (a new objective NPC, or one
--  whose role changed), the config changing (mark_targets and enabled both gate the
--  whole thing), and the level changing (goal_pos's answers are level-relative and every
--  cached position belongs to the level just left).
--  IT ALSO DROPS goal_pos's OFFLINE CACHE (OFFC, below) and the remembered level name,
--  because the one event both caches cannot survive is the same event: a level change.
--  Hooking one place rather than registering a second callback keeps "the world may have
--  moved under us" a single statement -- and the extra clearing the other callers cause
--  (a tracked entry appearing, a role changing, an option changing) costs one alife
--  round-trip per offline id on the next frame, which is the price of never having to
--  reason about which of two caches a given hook was wired to.
function route_goal_reset()
	GOALC.tg = nil
	OFFC.lname = nil
	-- Emptied in place rather than replaced: the per-id entry tables are the only
	-- allocation this cache makes, and a reset is not the moment to make another.
	for k in pairs(OFFC.e) do OFFC.e[k] = nil end
end

function route_goal()
	local tg = time_global and time_global() or 0
	-- `age >= 0` as well as `age < ttl`: a clock that went backwards (a load, a stub in a
	-- harness) must re-resolve rather than serve the cache until it catches up.
	local age = GOALC.tg and (tg - GOALC.tg)
	if age and age >= 0 and age < GOALC.ttl then
		if not GOALC.id then return nil end     -- the cached nil, at the same arity
		return GOALC.id, GOALC.pos, GOALC.online, GOALC.lvid
	end

	GOALC.tg = tg
	local id = route_target()
	local pos, online, lvid
	if id then pos, online, lvid = goal_pos(id) end
	if not (id and pos) then
		GOALC.id, GOALC.pos, GOALC.online, GOALC.lvid = nil, nil, nil, nil
		return nil
	end
	GOALC.id, GOALC.pos, GOALC.online, GOALC.lvid = id, pos, online, lvid
	return id, pos, online, lvid
end

--- Where object `id` is: position, whether it is ONLINE, and the navmesh vertex it
--  claims. nil for a dead creature and for anything on ANOTHER LEVEL.
--
--  PUBLIC, like active_task_target above, for the same reason: this module sits within
--  a dozen of the engine's 198-local budget and a shared helper is not worth one of
--  them. Two callers -- the route's goal and the placed waypoint -- and they need
--  exactly the same three answers about an id that may or may not be loaded.
--
--  THE ONLINE HALF IS LIVE; THE OFFLINE HALF IS CACHED AT ~4 Hz, and the split is the
--  whole point. An ONLINE object costs one level.object_by_id and one position() -- and
--  it is the half that MOVES: iqm_beacon's placed-waypoint marker exists partly so a
--  waypoint dropped ON AN NPC tracks that NPC as it walks, and staling that by a quarter
--  of a second would drag the mark behind the very target it is most for. An OFFLINE
--  object is by definition outside the online radius: it only moves when ALife updates
--  it, it is drawn as a screen-edge chevron with a metre-rounded readout, and reaching
--  it costs EIGHT engine round-trips and four allocations -- alife(), sim:object(),
--  se.position (userdata), game_graph(), :vertex(), :level_id(), sim:level_name() and
--  level.name() (two strings) -- which, asked every frame by two of the three callers,
--  is most of the GC this part of the frame produces. That is the branch worth a tick,
--  and route_goal above already serves the same objects a 200 ms-stale answer.
--
--  IT IS CACHED HERE AND NOT IN THE CALLERS on purpose. Three callers ask (route_goal,
--  iqm_beacon.waypoint_goal, iqm_beacon.task_goal) and two of them can be asking about
--  the SAME id on the same frame; a cache bolted onto one of them would let the marker
--  and the route disagree about where one object is, which is the class of bug the
--  second return exists to prevent rather than create.
--
--  NEGATIVE ANSWERS ARE CACHED TOO -- "no such object" and "on another level" are both
--  reached by paying most of that cost and finding nothing, and both are common (a
--  waypoint left standing on a level you have walked out of stays a nil answer for the
--  rest of the session). What makes that safe is that neither can silently become wrong:
--  a level change goes through route_goal_reset, which empties this cache, and an object
--  coming ONLINE never consults it at all -- get_obj answers first, so the transition is
--  picked up on the frame it happens and is served live from then on.
--
--  THE LEVEL TEST IS KEYED ON m_game_vertex_id, which is the only input it has. While
--  that is unchanged the answer is unchanged, so game_graph() / :vertex() / :level_id()
--  / :level_name() are skipped even on the frames that DO re-resolve -- an offline
--  target standing still costs three crossings per tick rather than eight per frame.
function goal_pos(id)
	-- Every caller already guards this, but the cache is keyed on `id` and a nil table
	-- key is an error rather than a miss -- so the guard is stated here as well.
	if not id then return nil end
	local obj = get_obj(id)
	if obj then
		-- Only creatures have a meaningful alive(); a crate, a smart terrain or the
		-- script_zone under a placed waypoint does not, and asking would drop
		-- perfectly good targets.
		if (IsStalker(obj) or IsMonster(obj)) and not obj:alive() then return nil end
		return obj:position(), true, obj.level_vertex_id and obj:level_vertex_id() or nil
	end

	local tg = time_global and time_global() or 0
	local e  = OFFC.e[id]
	if e then
		-- `age >= 0` for the same reason route_goal has it: a clock that went backwards
		-- (a load, a harness stub) must re-resolve rather than sit on the cache.
		local age = tg - e.tg
		if age >= 0 and age < OFFC.ttl then
			if not e.pos then return nil end        -- the cached nil, at the same arity
			return e.pos, false, e.lvid
		end
	else
		e = { tg = 0, pos = nil, lvid = nil, gvid = nil, away = false }
		OFFC.e[id] = e
	end
	e.tg = tg

	local sim = alife()
	local se = sim and sim:object(id)
	if not (se and se.position) then
		-- gvid too: the id may come back as a different object entirely.
		e.pos, e.lvid, e.gvid = nil, nil, nil
		return nil
	end
	local gvid = se.m_game_vertex_id
	if gvid and game_graph then
		if gvid ~= e.gvid then
			local lname = OFFC.lname
			if not lname then
				lname = level.name()
				OFFC.lname = lname
			end
			local gv = game_graph():vertex(gvid)
			e.gvid = gvid
			e.away = (gv and sim.level_name and sim:level_name(gv:level_id()) ~= lname) or false
		end
		if e.away then
			e.pos, e.lvid = nil, nil
			return nil
		end
	end
	e.pos, e.lvid = se.position, se.m_level_vertex_id
	return se.position, false, se.m_level_vertex_id
end

-- All three modes filter for our key first, as MCM's tutorial requires -- the
-- double_tap/key_hold timers are keyed on (id, key) and feeding them foreign keys
-- would corrupt the timing state. simple_press gives the press mode exclusivity: it
-- won't fire when the same key is being double-tapped or held, at the cost of one
-- double-tap window of input delay.
--
-- Press and double-tap ride on_key_press; long-press needs on_key_hold, which fires
-- every frame while the key is down. ui_mcm.key_hold returns true once the user's
-- configured press time has elapsed (MCM Key Bind settings -- shared with every other
-- mod, so a long press feels the same everywhere) and, with no repeat argument, not
-- again until the key is released.
local function on_key_press(key)
	if key ~= C.reveal_key then return end
	local mode = C.reveal_mode
	if mode ~= 0 and mode ~= 1 then return end
	if not mcm_keybinds then                    -- pre-1.6 MCM: no modifier/mode helpers
		toggle_reveal()
		return
	end
	if not ui_mcm.get_mod_key(C.reveal_mod) then return end
	if mode == 0 then
		ui_mcm.simple_press("iqm_reveal", key, toggle_reveal)
	elseif ui_mcm.double_tap("iqm_reveal", key) then
		toggle_reveal()
	end
end

local function on_key_hold(key)
	if key ~= C.reveal_key or C.reveal_mode ~= 2 then return end
	if not mcm_keybinds then return end         -- long press needs MCM's hold timer
	if ui_mcm.get_mod_key(C.reveal_mod) and ui_mcm.key_hold("iqm_reveal", key) then
		toggle_reveal()
	end
end

--- Is this body ALREADY showing something of ours -- a card or a marker?
--
--  The test both the placed waypoint and the selected task's marker stand down on, so one
--  body never carries two marks. It is a RANGE test and not just `tracked[id]`, which is
--  what it used to be (R2.38): quest targets are tracked at ANY range while their card
--  and marker are not, so `tracked` alone suppressed a waypoint in favour of something
--  that was never drawn, leaving nothing on screen at all.
--
--  IT HAS TO ASK ABOUT THE CARD SEPARATELY as of R2.46, and that is the subtle half. The
--  old test was `beacon_roles[role] and d < beacon_d`, which covered the card for free
--  because beacon_d >= appear_d and the one role a quest giver could have (`target`)
--  always carried a marker. R2.46 retired that marker, so beacon_roles answered `nil` for
--  a quest giver -- and without a second clause a waypoint dropped on one would have drawn
--  straight over the card it is supposed to defer to.
--
--  R2.60 GAVE `target` ITS MARKER BACK, and the second clause STAYS -- it was never only
--  about `target`. `work` and `important` carry no marker of their own and never have, and
--  a body carding one of those is exactly the case the first clause cannot see. The clause
--  is also what keeps `beacon_targets` from becoming load-bearing here: switch that row off
--  and the first clause goes quiet for a quest giver again, which is the R2.46 state, and
--  the waypoint still defers to the card because of this line rather than because of a
--  setting.
--
--  THE SECOND CLAUSE IS `f.card_up`, NOT `d < appear_d`, and the difference is a dead
--  band the waypoint harness found. Being inside card range is not the same as having a
--  card: an NPC off-screen or behind cover is tracked, in range, and drawing nothing. The
--  proxy therefore suppressed the waypoint on a role that carries no marker of its own --
--  `work` and `important` -- for a card that was not there, which is the R2.38 bug in a
--  new place. card_up is the hysteresis-damped flag the loop below already keeps, so this
--  reads exactly what the card actually did, one frame late. One frame is safe: the flag
--  only turns true once the card is at least half opaque.
--
--  THE ROLE CLAUSE ASKS WHETHER THE BODY IS STILL THERE (R2.60a), because the loop that
--  draws that marker does: its anchor needs `obj and obj:alive()`, while `tracked` holds an
--  NPC who died or went offline until the next scan prunes them. Without this the clause
--  claimed a mark nothing was drawing for up to one scan interval -- the R2.38 dead band
--  again, reached this time through the role that just got its marker back, and reached from
--  a direction goal_pos used to cover (it answers for offline ids; the tracked loop does
--  not). One level.object_by_id per call, and only for a body that is tracked, in range and
--  markered, which is the case that was about to return true anyway.
--
--  `carded` IS SPLIT OUT because the SELECTED task's own mark asks the narrower half of this
--  question. Like every other mark it stands down for the card on its body; unlike them it
--  must not stand down for the ROLE marker there, since R2.60 gave that body's `target` role
--  a marker of its own. See the offer_task call site: deferring would demote the objective
--  the player chose from prio 0 into the band every other turn-in competes in.
--
--  `tracked` and `FILT` never leave this file, which is why the test lives here and only
--  its ANSWER crosses the seam.
local function carded(id)
	local f = id and FILT[id]
	return (f and f.card_up) or false
end

local function marked(id, d)
	local t = id and d and tracked[id]
	if not t then return false end
	if beacon_roles[t.brole] and d < beacon_d then
		local obj = get_obj(id)
		if obj and obj:alive() then return true end
	end
	return carded(id)
end

local function render(tg)
	if not CARDS then return end
	-- Combat dim, eased BEFORE any of the early returns below (see SUP). It has to run on
	-- every frame the mod runs at all, not only on frames that draw something: park the
	-- ease behind the "nothing tracked" skip or the PDA/HUD gate and `f` goes stale for as
	-- long as that gate holds, so closing the PDA after a firefight would restore the cards
	-- at whatever opacity they were dimmed to when it opened -- and then ease from there.
	-- Cheap enough to sit ahead of them: with the feature off this is one compare and the
	-- timestamp store, and the timestamp has to be kept current anyway or the first frame
	-- after switching it back on eases from a dt measured in minutes.
	if SUP.ms > 0 then
		local dt = tg - SUP.t
		if dt < 1 then dt = 1 elseif dt > 100 then dt = 100 end   -- clamp against hitches, as the card fade does
		local target = (SUP.ads or tg < SUP.till) and SUP.lvl or 1
		-- Which way we are GOING picks the rate, not which trigger set it: a dim released
		-- by a hold expiring and one released by the sights coming down are the same
		-- movement on screen and should look the same.
		SUP.f = SUP.f + (target - SUP.f) * (1 - exp(-dt / ((target < SUP.f) and DIM_OUT_TAU or DIM_IN_TAU)))
		SUP.fc = SUP.cards   and SUP.f or 1
		SUP.fb = SUP.beacons and SUP.f or 1
	end
	SUP.t = tg

	-- Interference, eased here and for exactly the reasons above: it is an envelope with
	-- its own attack and release, this is the only per-frame path the mod has, and parked
	-- behind one of the gates below it would freeze at whatever the PDA interrupted and
	-- then carry on from there minutes later. Its own first line is `if not N.on then
	-- return end`, so switched off this is a call and a compare.
	--
	-- BEFORE the draws rather than after: everything downstream reads NZ this frame.
	noise_tick(tg)

	-- The summon envelope, eased here for the same reason and with the same shape as the dim
	-- above: this is the only per-frame path the mod has, and an ease parked behind one of
	-- the gates below would freeze at whatever the PDA or the hotkey interrupted and then
	-- carry on from there minutes later.
	--
	-- EASED ONLY WHILE IT IS MOVING, which is most of the point of landing on 0 and 1: both
	-- of the states a player spends whole minutes in are pinned, so a frame in either costs
	-- one compare and a store rather than an exp. That covers both ends -- route_reveal 0
	-- (or no key bound anywhere), where the answer is a constant yes and the envelope sits
	-- at 1, and the summon's ordinary resting state, where it sits at 0.
	local rw = route_wanted(tg)
	local target = rw and 1 or 0
	if SMN.a ~= target then
		local dt = tg - SMN.t
		if dt < 1 then dt = 1 elseif dt > 100 then dt = 100 end   -- clamp against hitches
		SMN.a = SMN.a + (target - SMN.a) * (1 - exp(-dt / (rw and SMN_IN_TAU or SMN_OUT_TAU)))
		-- LANDED at both ends, not approached (see SMN): 0 is the value iqm_nav throttles on
		-- and the draw skips on, and an asymptote never reaches it.
		--
		-- THE LOW THRESHOLD IS 0.02 AND NOT 0.004, which was measured rather than reasoned
		-- (first live session, R2.58): sampled at 100 ms through a fade, the mark pool was
		-- already showing NOTHING at an envelope of 0.036 while the ease went on running for
		-- another second to reach 0.004 -- a second of occlusion rays, chevron refills and
		-- projections per summon, for a route that had left the screen. 0.02 is below the
		-- point anything was still drawn at and is worth ~0.7 s of that back. It cannot be
		-- raised much further on this evidence: 0.036 was one route's geometry, and a near
		-- unoccluded mark takes the envelope almost undiminished (0.02 * route_a 255 = 5,
		-- which the a > 2 cut in draw_route still passes).
		if SMN.a > 0.996 then SMN.a = 1 elseif SMN.a < 0.02 then SMN.a = 0 end
	end
	SMN.t = tg
	-- hide everything while the PDA is up or the main HUD is hidden; keep per-NPC state
	-- so coming back resumes cleanly (no re-chirp, no replayed entrance). The PDA is
	-- checked separately because it hides the indicators engine-side, which never
	-- reaches the Lua state main_hud_shown() reads.
	-- The reveal hotkey rides the same path on purpose: keeping the tracked set alive
	-- means letting go of the key and pressing it again resumes instantly, with no
	-- rescan, no replayed entrance animation and no second chirp. (Gating update() or
	-- C.enabled instead would clear_all() and pay a full rescan on every release.)
	--
	-- ABOVE the route/waypoint resolution below, and it used to be under it. That order
	-- was not arbitrary -- the "nothing to draw" skip genuinely needs both answers before
	-- it may fire -- but the HIDDEN case needs neither, and both cost something on every
	-- frame the PDA is up or the reveal key is not held: waypoint_goal() re-polls the
	-- placing mod on a 250 ms timer and resolves the object's position, and route_draw()
	-- is a call across the module seam. Nothing is lost by asking later, because both hide
	-- paths this branch takes are latched no-ops -- hide_beacons and hide_route both
	-- early-out when there is nothing shown -- and iqm_nav stops PUBLISHING while the
	-- overlay is hidden anyway, so route_draw() would have answered nil regardless.
	-- The waypoint poll is self-correcting for the same reason it is throttled: its
	-- deadline is simply overdue when the overlay comes back, so the first visible frame
	-- re-polls immediately.
	--
	-- One accessor call, not the three primitives inline. Same expression, memoised on
	-- the frame clock, and iqm_nav asks for the same answer later in the same frame --
	-- see overlay_visible.
	--
	-- TWO GATES SINCE R2.58, because the summon has to be able to bring the ground line up
	-- while the nameplates are down -- a player who toggles the cards off and then asks for
	-- a route must get one, and under the single gate this used to be they got nothing. So
	-- the cards, beacons and waypoint marks ride `vis` (the old answer, unchanged), and the
	-- route rides `ra`, which is the same PDA/HUD pair times its own envelope.
	local vis = overlay_visible(tg)
	local ra  = route_alpha(tg)
	if not (vis or ra > 0) then
		for _, t in pairs(tracked) do CARDS:hide_slot(t.slot) end
		hide_beacons(CARDS)
		CARDS:hide_route()
		return
	end
	if not vis then
		-- ROUTE-ONLY FRAME: summoned, with the nameplates hidden by the hotkey (or by the
		-- HUD being up while... no -- `ra` carries the PDA and HUD gates too, so the only
		-- way here is the reveal rule). The card halves are hidden through the same latched
		-- no-ops as above, so this costs one pass over `tracked` on the frame the state
		-- changes and nothing on the frames after it.
		for _, t in pairs(tracked) do CARDS:hide_slot(t.slot) end
		hide_beacons(CARDS)
		local rd = iqm_nav and iqm_nav.route_draw and iqm_nav.route_draw()
		if rd then
			cards_kx_tick(device())   -- the route reads the aspect factor; see below
			-- route_limit's two returns go through locals rather than straight into the
			-- call: a multi-return expression is truncated to ONE value when it is not the
			-- last argument, so passing the envelope after it inline would silently hand
			-- `nc` the alpha and drop the chevron count.
			local rn, rnc = iqm_nav.route_limit(C.route_dist)
			CARDS:draw_route(rd, rn, rnc, ra)
		else
			CARDS:hide_route()
		end
		return
	end
	-- The two things drawn here that are NOT a tracked NPC, resolved before the cheap
	-- skip below because they are what decides whether it may fire.
	--
	-- The published route (hoisted from its draw call at the foot of this function):
	-- iqm_nav follows the SELECTED task, which is frequently a marker rather than a
	-- carded NPC -- a placed waypoint always is -- so "nothing tracked" stopped meaning
	-- "nothing to draw" when the route began following it. route_draw() answers nil in
	-- one comparison when it is not publishing, so asking here costs nothing.
	--
	-- The C.mark_route test is HERE and not only at configure time because iqm_nav also
	-- publishes for the minimap trail, which is independently switchable: a published
	-- route no longer implies the ground line was asked for.
	--
	-- The published list runs as far as the LONGER of the two views wants (see
	-- route_draw_dist), so the ground line asks how much of it is its own.
	--
	-- `ra > 0` replaced the C.mark_route / w2u_ok pair here at R2.58: route_alpha folds both
	-- of them in (it has to -- iqm_nav asks it the same question), and adding the envelope
	-- beside them would have stated the same gate in two places. It also keeps the cheap
	-- "nothing to draw" skip below available on the frames the route is faded out, which is
	-- most of them for a player who has moved the route onto the summon.
	local rd = ra > 0 and iqm_nav and iqm_nav.route_draw and iqm_nav.route_draw()
	local wid, wpos = waypoint_goal()
	-- C.beacon_party joins the three since R2.57, and it has to: a companion is never in
	-- `tracked`, so a player with the party marker on and nothing else on screen would
	-- take this early return every frame and never see one. Read as the raw option rather
	-- than through iqm_beacon, which is one call further away for the same answer -- with
	-- the switch on and the companion mod absent, offer_party's own guard bails and the
	-- frame costs a projection matrix it would otherwise have skipped.
	if next(tracked) == nil and not wpos and not rd and not C.beacon_party then
		hide_beacons(CARDS); CARDS:hide_route(); return   -- nothing to draw: skip the device work entirely
	end
	-- Aspect factor only changes when the resolution does, so recompute it just then
	-- (not every frame). The leader line reads it, and so do the marker and the route;
	-- it lives with them in iqm_cards, and this is the per-frame poke that keeps it
	-- current. Driven from here because this is the frame path, not because the value
	-- is ours.
	cards_kx_tick(device())
	-- ...and focus mode's half of that same number, refreshed on the same beat and only
	-- when the feature is on. The reciprocal is taken HERE, once, rather than per NPC:
	-- the ring test runs on every carded body every frame and a division is the one
	-- operation in it that never needed to be there.
	if FOC.on then FOC.kxi = 1 / cards_kx() end
	local apos = db.actor:position()   -- actor position once per frame, not per NPC

	-- THE TWO NAVIGATION MARKS, offered BEFORE the NPCs so they take beacon slots ahead of
	-- them (both prio 0). What either offer LOOKS like is iqm_beacon's -- the marker is
	-- its mark -- and what is decided HERE is the pair of questions this file alone can
	-- answer, because both are about `tracked`, which never leaves it:
	--
	--   * is that body ALREADY showing something of ours? (`marked`, above -- so
	--     waypointing your quest giver leaves one mark on it rather than two; that NPC's
	--     own marker then wears the waypoint ring instead, R2.38, see `is_wp` below)
	--   * are these two the SAME body? (`merged` -- see below, it is the common case)
	local tid, tpos, tkind, tcomm = task_goal()
	-- THE TWO ARE THE SAME OBJECT MORE OFTEN THAN NOT. Placing a waypoint SELECTS its own
	-- task, so `tid == wid` is the DEFAULT state right after placing one, not a corner
	-- case. One mark is drawn for it and it is the task's -- the full reticle, which is
	-- the stronger of the two statements; offer_task carries the waypoint's own WP_NEAR
	-- suppression across with the identity so nothing else about it changes.
	local merged = (tid ~= nil and tid == wid)

	local wd = wpos and wpos:distance_to(apos)
	if not merged then offer_waypoint(wid, wpos, wd, marked(wid, wd)) end

	-- ...and the selected task, at the same prio 0. Sourced from active_task_target, NOT
	-- route_target: the route falls back to the nearest tracked turn-in when nothing is
	-- selected and this deliberately does not, so the marker can never point somewhere
	-- the map's bracket is not. The consequence is chosen rather than overlooked -- with
	-- no task selected the route still draws to a turn-in that now carries no marker.
	local td = tpos and tpos:distance_to(apos)
	-- `tkind` only dresses the mark (skull / red reticle); it never decides whether one
	-- is offered, which stays entirely task_goal's hand-in gate.
	--
	-- `carded` RATHER THAN `marked`, and this is the half of R2.60 that had to come with it
	-- (R2.60a). Giving `target` a marker back made the selected task's own body answer the
	-- role clause of `marked`, so this offer stood down and the mark was re-offered from the
	-- tracked loop below at ROLE_PRIO.target -- prio 1, where it ties with every other pending
	-- turn-in and breaks on METRES. Six nearer hand-ins inside beacon_dist and the task the
	-- player selected on the PDA was the one evicted from the six slots: exactly the silent
	-- eviction R2.39's prio ordering exists to prevent, and it could not happen while prio 0
	-- was unreachable from a role. So the precedence runs the other way round -- this offer
	-- keeps prio 0 and the loop skips this body (`id ~= tid` there) -- and what this still
	-- defers to is the CARD on it, which marks that body better than either marker.
	--
	-- THE GIVER'S COMMUNITY GOES WITH IT (R2.63) and the COLOUR does not, which is the
	-- shape the consistency fix had to take. offer_task used to resolve its own tint and
	-- was the one path of three that did not consult beacon_color; it now reads the one
	-- resolver, beacon_tint -- but it reads it from over THERE, because this function is
	-- at exactly LuaJIT's 60 upvalues and naming beacon_tint here would not compile.
	-- So this side passes the one input only it can answer, the same way it already
	-- passes `carded` and `merged`: mode 2 needs the giver's COMMUNITY, and that is
	-- cached on the tracked entry, which never leaves this file.
	--
	-- tracked[tid] CAN BE ABSENT and the nil is passed on deliberately: a task target far
	-- enough away to be outside appear_dist is never carded and has no entry, so there is
	-- no community to know. beacon_tint falls back to STALKER's amber for that, the same
	-- fallback the role path has always taken for a giver whose community is unlisted.
	-- THE COMMUNITY COMES FROM task_goal, NOT FROM `tracked` (R2.63c). It used to be read
	-- off the tracked entry here, which meant mode 2's answer depended on whether the
	-- giver happened to be inside the scan's reach -- and this marker has no range gate,
	-- so it is routinely outside it. task_goal resolves it from the SERVER object on the
	-- same throttled tick as the id, which answers the same at every distance; see the
	-- note there. ONE source rather than the nearer of two, so the mark cannot change
	-- colour as the player walks toward it.
	offer_task(tid, tpos, td, carded(tid), merged, tkind, tcomm)

	-- ...and the party, LAST of the three and behind every role as well (prio 7 inside
	-- offer_party). Offered from here rather than from the loop below because a companion
	-- is not tracked: it has no card role, so the scan never names it and `tracked` never
	-- holds it. The four things this file is passing are the four it alone can answer --
	-- where the actor is, how far the marker reaches (beacon_d is this file's mirror), and
	-- which bodies the two navigation marks have already claimed.
	-- Its tint comes from the same one resolver, called on ITS side of the seam for the
	-- reason above. Nothing extra is passed: `party` is not a turn-in, so mode 2 has
	-- nothing to override with and there is no community worth carrying over.
	offer_party(apos, marked, beacon_d, wid, tid)

	for id, t in pairs(tracked) do
		local f = FILT[id]
		if not f then f = { a = 0 }; FILT[id] = f end

		local obj = get_obj(id)
		local hx, hy, vis, dist
		local bpos, bdist   -- beacon anchor + range; the beacon reaches past the card's
		if obj and obj:alive() then
			-- Beyond appear_dist the card's alpha is 0 anyway (alpha_for_dist), so an
			-- out-of-range tracked NPC (e.g. a quest target far across the map) would only
			-- produce an invisible card. Skip the anchor / shoulder / projection / LOS work
			-- entirely for it; it resumes the moment the NPC comes back within range. The
			-- gate compares squared distances, so the (common) out-of-range case never
			-- pays the sqrt; the real distance (shared by fade + node size) is only taken
			-- once in range.
			local opos = obj:position()
			local d2 = opos:distance_to_sqr(apos)
			-- The beacon's gate is the wider one, and it is per-role: out of the box
			-- only the hand-in passes, so every other role stays a card-range affair
			-- until its switch is turned on.
			if beacon_roles[t.brole] and d2 < beacon2 then
				bpos, bdist = opos, sqrt(d2)
			end
			if d2 < appear2 then
				dist = bdist or sqrt(d2)
				local wpos, rux, ruz = anchor_world_pos(obj, id)
				-- auto shoulder side: recompute which shoulder only every SIDE_RATE ms (two extra
				-- projections) and reuse the sign in between; then offset the anchor onto it in place.
				local amt = side_amt
				if auto_side and amt > 0 and not (rux == 0 and ruz == 0) then
					if f.side_sign == nil or tg >= (f.side_next or 0) then
						f.side_sign = shoulder_sign(wpos, rux, ruz, amt)
						-- ...and scattered on the FIRST pick the same way has_los's cast is
						-- (PHASE_MUL), for the same reason and off the same id: a group
						-- that becomes carded on one frame would otherwise re-pick in
						-- lockstep for as long as it stays carded, turning ~2 world2ui a
						-- frame into 16 on one frame in six. Every deadline after the
						-- first is the plain tg + SIDE_RATE, so the rate is unchanged.
						if f.side_next then
							f.side_next = tg + SIDE_RATE
						else
							f.side_next = tg + ((id * PHASE_MUL) % SIDE_RATE)
						end
					end
					local sgn = f.side_sign
					if sgn ~= 0 then
						wpos.x = wpos.x + sgn * rux * amt
						wpos.z = wpos.z + sgn * ruz * amt
					end
				end
				hx, hy = project_world(wpos)
				if hx then
					vis = has_los(id, obj, wpos, tg)   -- head bone fetched inside, only on a cast frame
				end
			end
		end
		local target_a = (hx and vis and alpha_for_dist(dist)) or 0

		-- framerate-independent ease: the alpha fades and the entrance rise both
		-- settle over a fixed time regardless of FPS (dt clamped against hitches).
		local dt = tg - (f.ftg or tg)
		if dt < 1 then dt = 1 elseif dt > 100 then dt = 100 end
		f.ftg    = tg
		local kf = 1 - exp(-dt / FADE_TAU)
		f.a      = f.a + (target_a - f.a) * kf
		f.appear = (f.appear or 0) + (1 - (f.appear or 0)) * (1 - exp(-dt / APPEAR_TAU))

		-- FOCUS, and it is applied to the PIXELS ONLY -- never to target_a and never to
		-- f.a. This is the same rule the combat dim states at the draw call below, and it
		-- is not a style preference: f.a is control flow, and two branches immediately
		-- below read it.
		--
		--   * `f.a < 96` RELEASES THE MARKER BACK. Dimming through f.a would summon a
		--     through-wall beacon for every NPC the player looked away from -- exactly
		--     inverting a feature whose whole purpose is to take marks off the screen.
		--   * `f.a < 2` hides the slot and resets f.appear/f.seen, so sweeping the
		--     crosshair back across someone would replay the entrance rise and re-fire
		--     the chirp.
		--
		-- Keeping f.a honest means an unfocused card stays "up" as far as the handover is
		-- concerned and goes on suppressing its own beacon -- so looking away gives you
		-- NOTHING, which is the RDR2 reading and the one this feature was asked for.
		--
		-- It rides `kf` rather than easing on a tau of its own: the fade is already 90 ms,
		-- which is faster than a head turn crosses the ring, and reusing it costs no
		-- second exp() per NPC per frame.
		local ftgt = focus_factor(hx, hy, t.role)
		f.fa = (f.fa or ftgt) + (ftgt - (f.fa or ftgt)) * kf
		-- CROSSING THE RING CAN CHANGE WHO IS ENTITLED TO A SLOT, and the rank is rebuilt
		-- only on the scan interval (see the fb key in update). Flag the crossing here --
		-- one boolean compare per card -- and let the foot of this function decide whether
		-- it is worth a re-rank; most of the time it is not.
		-- Behind FOC.on so that with the feature off `f.fon` is never written at all: the
		-- rank demotes on the value FALSE and treats nil as "no opinion yet", which is
		-- what keeps a newly-desired NPC entitled to a slot on the pass it first appears.
		if FOC.on then
			local fon = ftgt > 0.5
			if fon ~= f.fon then
				f.fon    = fon
				FOC.flip = true
			end
		end

		-- Card and beacon are MUTUALLY EXCLUSIVE, not a proportional blend. Blending
		-- the beacon against the card's alpha read fine at the extremes but left both
		-- markers up across the whole full_dist..appear_dist band, where the card sits
		-- at partial alpha for as long as you stand there: at 12 m of a 9/16 fade you
		-- got a card at ~145/255 AND a beacon at ~97, on the same NPC, permanently.
		--
		-- So one flag decides, and the beacon carries its own eased alpha so the
		-- handover is still a dissolve rather than a pop. The two edges deliberately
		-- read different things:
		--   * suppress on the card's TARGET alpha, which has no lag -- otherwise an
		--     NPC who is already close when they become tracked shows a beacon flash
		--     while the card is still easing up from zero.
		--   * release on the card's ACTUAL alpha, once it really has faded away.
		-- Asymmetric on purpose, and it doubles as the hysteresis that stops an NPC
		-- parked exactly on the fade boundary flipping the pair every frame.
		-- THE THRESHOLDS ARE ABOUT LEGIBILITY, not about non-zero (R2.33i). They were 24
		-- and 6 -- i.e. the beacon stood down the moment the card reached 9% opacity, and
		-- did not come back until it was under 2%. Over a 9/16 m fade that hands over at
		-- 15.3 m and leaves a band from about 14 m to 15.3 m with a card at 18% and NO
		-- beacon: nothing legible on screen at all, on a target you are looking straight
		-- at. Reported as "lots of examples of no markers showing up", and the log had the
		-- NPC at 14.7 m with a clear line of sight, which is 47 of 255.
		--
		-- The card only takes over once it is at least HALF opaque, which is the point it
		-- can actually be read; the beacon returns once the card is under 38%. The gap
		-- between the two is the hysteresis that stops an NPC parked on the boundary
		-- flipping the pair every frame, and it is why they are not the same number.
		if not hx then
			f.card_up = false            -- off-screen: the card hides this frame anyway
		elseif target_a >= 128 then
			f.card_up = true
		elseif f.a < 96 then
			f.card_up = false
		end
		f.ba = (f.ba or 0) + ((f.card_up and 0 or 255) - (f.ba or 0)) * kf

		-- Name resolved HERE and not in the card branch below, which is where it used to
		-- live. That branch runs only when the card is visible -- and the marker exists
		-- for exactly the case it isn't -- so a name read from there would be empty in
		-- every situation the marker is for. Still once per NPC: the name is stable.
		-- Guarded on obj: an offline / just-despawned NPC would otherwise cache "" as the
		-- answer and never look again.
		if obj and not t.name then t.name = name_from_obj(obj) end
		-- `id ~= tid` YIELDS THIS BODY TO THE SELECTED TASK'S OWN MARK (R2.60a), the same
		-- outright skip offer_party makes for the same invariant, and the mark it yields to
		-- was offered above. Three things the role marker cannot state are why it is the one
		-- that stands down: prio 0, the KIND dressing (skull / red reticle), and no range
		-- gate -- so without this, walking in past beacon_dist swapped one mark for the other
		-- and the mark changed tint on the way (mode 2's faction override is a role rule) and
		-- grew a name caption. `wid` is NOT skipped here and that asymmetry is right: the
		-- waypoint's mark survives the handover as a ring on this one (R2.38), while the
		-- task's cannot be worn by another glyph.
		if bpos and id ~= tid then
			-- ...and if the player's waypoint is on THIS NPC, the marker wears the ring
			-- that the stood-down waypoint marker would have drawn (R2.38). Free: `wid`
			-- was already resolved above for the suppression test.
			--
			-- `true` MEANS THE WAYPOINT'S RING, which is a sentinel rather than the texture
			-- id beacon_offer now stores, and the reason is the upvalue budget (R2.63): this
			-- function sits at exactly LuaJIT's 60, so naming BEACON_RING here would not
			-- compile -- the file would not load and every feature would go with it. It costs
			-- nothing to say it this way: there are two rings and this path can only ever ask
			-- for one of them, since the other belongs to the offer this loop stands down for
			-- three lines up. beacon_offer resolves the default; offer_task names its own.
			--
			-- ROLE_PRIO is what keeps a turn-in from being evicted by a shop when more
			-- candidates than slots are in range (R2.39; see beacon_offer). Read from the
			-- same table the card slots sort by, so the two orderings cannot drift apart.
			beacon_offer(id, bdist, f.ba / 255, bpos.x, bpos.y, bpos.z, BEACON_ICON[t.brole],
			             ROLE_PRIO[t.brole], t.bcol,
			             C.beacon_name and t.name or nil, wid ~= nil and id == wid)
		end

		if f.a < 2 or not hx then
			CARDS:hide_slot(t.slot)
			f.appear = 0   -- replay the entrance next time this card shows
			f.seen   = false
		else
			-- first time this card comes into view (after being hidden): chirp, gated by a
			-- per-NPC cooldown and a short global throttle so re-glances / simultaneous
			-- appearances don't spam the sound. Ambient role cards stay silent (walking
			-- through a trade hub shouldn't sound like a pocket full of pagers).
			-- ...AND GATED ON FOCUS, which is why `f.seen` is not simply set here. At modes
			-- 2 and 3 the chirping roles are themselves focus-gated, so without this the
			-- mod would beep at a card the player cannot see -- and having beeped, would
			-- mark it seen and stay silent when they finally looked at it. Deferring the
			-- flag instead moves the chirp to the moment the card becomes readable, which
			-- is where it belonged anyway. With focus off ftgt is 1 and this reads exactly
			-- as it always did.
			if not f.seen and ftgt > 0.5 then
				f.seen = true
				if CHIRP_ROLES[t.role] and tg >= (f.chirp_t or 0) and (tg - _chirp_last) > 120 then
					f.chirp_t   = tg + SOUND_CD
					_chirp_last = tg
					play_chirp()
				end
			end
			local rx, ry = smooth_point(id, hx, hy, tg)
			local lift   = (1 - ease_out_quint(f.appear)) * APPEAR_LIFT
			-- The combat dim is applied HERE, to the alpha handed to the draw, and NEVER to
			-- f.a itself. f.a is not just a colour -- it is control flow, and two branches
			-- above read it:
			--
			--   * `f.a < 96` releases the marker back (the card/marker handover hysteresis).
			--     Scaling f.a by the dim would drop it under 96 and SUMMON THE MARKER every
			--     time a card dimmed, which is exactly backwards.
			--   * `f.a < 2` hides the slot and resets f.appear and f.seen. Dimming through
			--     that would replay the entrance rise AND re-fire the chirp on release --
			--     a PDA beep on every shot fired.
			--
			-- So the eased value stays the honest distance/LOS answer and only the pixels
			-- get quietened. The consequence is that at dim_level 0 the widget stays alive
			-- at alpha 0 rather than being hidden; invisible either way, and it is what
			-- keeps the entrance and the chirp from replaying.
			--
			-- FOCUS RIDES THE SAME MULTIPLY, for all of the reasons above and one more of
			-- its own: it must not release the marker (see the note where f.fa is eased).
			-- The two factors compose rather than competing -- a card can be both dimmed by
			-- gunfire and outside the ring, and the answer is that it is quieter still.
			--
			-- ...AND SO DOES INTERFERENCE (NZ.af), which is the third factor and composes
			-- with both for the same reason. It is 1 whenever the feature is off or below
			-- its dropout tier, so on every ordinary frame this is a multiply by one.
			-- Three multipliers deep is exactly the compounding R2.26 is the standing
			-- lesson about, which is why none of the three is allowed to reach 0 by
			-- default: see noise_giveup, dim_level and the focus floor.
			CARDS:draw_slot(t.slot, rx, ry, t.htext or header_for(t.role, t.hkey), t.name, f.a * SUP.fc * f.fa * NZ.af, C, node_scale_for_dist(dist), lift,
			                t.icon, t.chip, t.cr, t.cg, t.cb, t.icon_tinted, tg)
		end
	end
	-- A CARD CROSSED THE RING: rebuild the slot rank early, but only when it can change
	-- anything. The rank runs on SCAN_INTERVAL (2 s) and focus answers a head turn, so
	-- without this a player who turns to face a trader in a saturated hub waits up to two
	-- seconds for the card -- the feature would read as laggy exactly where it is most
	-- wanted, which is a crowd.
	--
	-- THE TWO GUARDS ARE BOTH LOAD-BEARING. `sat` is last pass's "there were more
	-- candidates than slots": below the cap every candidate already holds a slot and the
	-- ordering among them changes nothing on screen, so a head turn in open country must
	-- not buy a merge. The debounce is because sweeping across a camp crosses the ring
	-- once per body, and the merge (collect, rank, re-decorate) is the most expensive
	-- thing this file does -- see the note about not landing it on the same frame as the
	-- scanner's last slice.
	--
	-- next_scan = 0 rather than a timestamp: it is the same "you are overdue" idiom
	-- debug_rescan uses, and update() runs from actor_on_update BEFORE render, so the
	-- re-rank lands on the very next frame.
	if FOC.flip then
		FOC.flip = false
		if FOC.sat and tg >= FOC.next then
			FOC.next  = tg + FOCUS_RERANK
			next_scan = 0
		end
	end
	-- The route, if iqm_nav has one to publish (resolved at the top of this function).
	-- It decides everything about WHICH points and how visible each is; all that happens
	-- here is projecting them and putting sprites on screen. Drawn before the beacons
	-- for the same reason its widgets are created first: ground furniture goes under the
	-- markers.
	if rd then
		-- Two locals rather than the multi-return inline, so the envelope can be the last
		-- argument -- see the note at the route-only branch above.
		local rn, rnc = iqm_nav.route_limit(C.route_dist)
		CARDS:draw_route(rd, rn, rnc, ra)
	else
		CARDS:hide_route()
	end

	-- beacons last: the candidate set is only complete once every tracked NPC has
	-- had its card alpha eased above (that alpha IS the beacon's crossover).
	-- The combat dim goes over as a NUMBER rather than being pulled through the seam:
	-- it is frame state, not config -- it changes every frame, which is the one thing
	-- apply_config's pull model does not cover.
	-- ...and interference's multiplier rides across the same way, folded into the one
	-- number rather than added as a second argument: both are frame state and the marker
	-- has no more reason to know which of them quietened it than the card does.
	draw_beacons(tg, CARDS, SUP.fb * NZ.af)
end

-- --------------------------------------------------------------------------
-- Debug seam (the drivers themselves live in iqm_debug.script)
-- --------------------------------------------------------------------------
-- The F7 card-pinning drivers moved out at R2.44. This file was at 193 of the 198
-- locals a .script gets and going over is a syntax error AT LOAD -- so the debug
-- scaffolding was the first thing asked to pay that rent. What is left here is the
-- seam it needs, which is two things and no state:
--
--   * this function, so a pin applies on the next update instead of waiting out the
--     scan interval (next_scan is ours and stays ours), and
--   * the merge in update(), which reads iqm_debug.pins.
--
-- Both sides are guarded, so either file loads and works with the other absent and
-- neither may assume load order.
function debug_rescan()
	next_scan = 0
end
-- --------------------------------------------------------------------------
-- Scan / update loop
-- --------------------------------------------------------------------------
-- Slot-ranking scratch, reused across passes: see the note at its fill site below.
local _order = {}
local function update()
	if not db.actor then return end
	if not C.enabled then
		if next(tracked) then clear_all() end
		return
	end

	-- Who the mod wants marked, from iqm_scan: quest targets, the guide job, the
	-- recruitables and the service/VIP roles, already merged in precedence order.
	local desired = scan_desired()
	-- Read IN THE SAME BREATH, because desired_set wipes this set at the top of its
	-- next call and the two only describe the same pass until then.
	local marker  = scan_marker()

	-- debug_card pins (iqm_debug): forced entries that override the detected role,
	-- since forcing the style is the point of the tool. Dead/gone NPCs drop their pin.
	-- Read through the module each scan rather than cached: debug_clear REBINDS the
	-- table (pins = {}), so a held reference would go on serving the old one.
	local pins = iqm_debug and iqm_debug.pins
	if pins and next(pins) then
		for id, role in pairs(pins) do
			local obj = get_obj(id)
			if obj and obj:alive() then
				desired[id] = role
			else
				pins[id] = nil
			end
		end
	end

	-- Removed DURING the walk rather than collected into a list and removed after.
	-- remove_entry only clears fields that already exist (tracked[id], FILT[id]), and Lua
	-- explicitly permits clearing existing fields mid-pairs() -- it is assigning to a
	-- field that was never there that makes next() undefined. So the intermediate list
	-- bought nothing but an allocation and a second loop on every scan pass.
	for id in pairs(tracked) do
		if not desired[id] then remove_entry(id) end
	end

	-- objectives claim card slots first, ambient roles last: claim in ROLE_PRIO
	-- order, nearest first within a priority (banded; see slot_order_cmp), so a
	-- full slate of objectives is never crowded out by nearby recruitables or
	-- service NPCs, and a saturated camp cards the closest work-havers.
	-- The ranking entries come from a pool that persists between passes (the same reason
	-- _bcand is preallocated on the marker path): a hub with thirty candidates was building
	-- thirty short-lived tables plus the array every scan. The tail is trimmed only when
	-- the count SHRINKS, so an area with a steady population allocates nothing at all after
	-- the first pass, and table.sort still sees an array of exactly `n`.
	local n = 0
	local apos = db.actor:position()
	for id, role in pairs(desired) do
		local obj  = get_obj(id)
		local band = obj and floor(sqrt(obj:position():distance_to_sqr(apos)) * 0.25) or 999
		n = n + 1
		local e = _order[n]
		if not e then e = {}; _order[n] = e end
		e.id, e.role, e.band, e.obj = id, role, band, obj
		-- FOCUS, AS THE FIRST SORT KEY (0 entitled, 1 demoted). Without it the filter is
		-- only a dim, and a dim does not free a slot: in a hub with more candidates than
		-- MAX_CARDS all eight could be held by bodies the player is not looking at, and
		-- the one they turned to face would be the one with nothing over it -- the exact
		-- crowding-out the cap's own eviction was added to fix, arriving through a new door.
		--
		-- READ BACK OFF THE RENDER PATH rather than recomputed here. `f.fon` is the
		-- crosshair answer the draw actually used, so the rank and the pixels can never
		-- disagree about who is focused; recomputing it would mean projecting every
		-- candidate (not just the carded ones) on the scan pass, which is thirty
		-- projections to re-derive eight numbers already in hand.
		--
		-- ONLY `false` DEMOTES. nil means "the render path has no opinion about this body
		-- yet" -- a candidate that has never been carded, which is every candidate on the
		-- pass it first appears -- and demoting those would deny a slot to exactly the
		-- NPC who just walked into the ring. The cost of being wrong the other way is one
		-- scan interval of an invisible card holding a slot; the debounced re-rank in
		-- render() shortens even that.
		e.fb = (FOC.on and FILT[id] and FILT[id].fon == false) and 1 or 0
		-- THE MARKER'S ROLE, which is not always the card's (R2.58). Some of the roles that
		-- win a card carry no marker -- `work`, `important`, and `delivery`, which has never
		-- been keyed in beacon_roles -- and one of them winning must not take the marker away
		-- from a service role the same NPC also qualifies for. iqm_scan.want_marker resolves
		-- that; this reads its answer. (`target` was in that list from R2.46 until R2.60 gave
		-- it a marker again, and rejoins it whenever beacon_targets is switched off -- which is
		-- why the mechanism is not about any one role.)
		-- nil is the honest "no marker for this body", and it is what most entries get.
		--
		-- A DEBUG PIN DRIVES BOTH, since forcing the style is the whole point of the tool,
		-- and a pin never goes through `want` so want_marker has not seen it. Checked here
		-- rather than written into iqm_scan's set: that table has one writer by design.
		e.brole = (pins and pins[id]) or marker[id]
	end
	for i = #_order, n + 1, -1 do _order[i] = nil end
	table.sort(_order, slot_order_cmp)
	-- Only the top MAX_CARDS ranked are entitled to a slot. Without this, an
	-- already-tracked ambient card kept its slot while a better-ranked newcomer
	-- (even a fresh quest target) was skipped; mark_work makes saturation common
	-- enough that below-the-line entries must yield their slots first.
	for i = MAX_CARDS + 1, n do
		local id = _order[i].id
		if tracked[id] then remove_entry(id) end
	end
	-- WERE THE SLOTS CONTENDED? Recorded before the clamp below throws the count away,
	-- because it is the whole of what focus's early re-rank is allowed to act on: below
	-- the cap the ordering decides nothing that reaches the screen (see the FOC.flip
	-- block in render).
	FOC.sat = n > MAX_CARDS
	if n > MAX_CARDS then n = MAX_CARDS end
	-- resolve the glyph + chip flag once here (role is stable for a tracked entry's
	-- life), so the per-frame render() path reads a field instead of recomputing.
	for i = 1, n do
		local e = _order[i]
		ensure_entry(e.id, e.role)
		local t = tracked[e.id]
		if t then
			-- Stamped once per pass beside the glyph and for the same reason: the render path
			-- reads a field instead of a second table on every tracked NPC every frame.
			t.brole = e.brole
			local ricon = icon_for(e.role)             -- role glyph (ambient cards) or nil
			t.icon        = ricon
			t.chip        = C.role_style == 2
			t.icon_tinted = true                       -- role glyphs tint to the accent colour

			-- work cards refine HIRING with the job kind. Re-read each pass (unlike the
			-- role, the pinned task and with it the kind can change when the verdict
			-- refreshes); nil for other roles and for unclassified offers.
			t.hkey = (e.role == "work" and tw_kind) and WORK_HDR[tw_kind(e.id)] or nil

			-- hire cards advertise the actual 24h price when it's readable (see
			-- hire_price). Built here, once per pass, because unlike every other
			-- header it isn't a fixed string the translation cache can hold; the
			-- draw path just reads the field. Cleared for every other role, since a
			-- debug pin can change a tracked entry's role under us.
			if e.role == "hire" then
				local p = hire_price_of(e.id)
				t.htext = p and string.format(header_for("hire", "st_iqm_hdr_hire_price"), p) or nil
			else
				t.htext = nil
			end

			-- Faction lookup, resolved once per NPC (community is stable for its life)
			-- and cached on the entry, so the per-frame draw path stays lookup-free. The
			-- tracked set is wiped on any option change (clear_all), so toggling either
			-- faction option re-resolves cleanly.
			if (C.faction_colors or C.faction_icons or C.beacon_color == 2)
			   and t.fcomm == nil then
				t.fcomm = (e.obj and char_comm(e.obj)) or false
			end
			local frgb = t.fcomm and FACTION_RGB[t.fcomm]

			-- faction_colors: tint the whole card to the faction colour, else keep the gold.
			if C.faction_colors and frgb then
				t.cr, t.cg, t.cb = frgb[1], frgb[2], frgb[3]
			else
				t.cr, t.cg, t.cb = C.col_r, C.col_g, C.col_b
			end

			-- Marker tint (beacon_color), resolved here rather than per frame for the same
			-- reason the glyph is: role and community are both stable for a tracked entry's
			-- life. Keyed on the MARKER's role and not the card's: this IS the marker's tint,
			-- so it has to agree with the glyph beside it.
			--
			-- THE RULE ITSELF LIVES IN beacon_tint (R2.63) and no longer here. What used to be
			-- ten lines of mode tests was one of THREE copies of them -- offer_task's third copy
			-- disagreed, which is the bug that change fixes -- so the modes, the mode-3 nil and
			-- mode 2's faction override are all stated once, over there, and read from all three
			-- paths. This line is now only the part that was ever this pass's business: which
			-- entry is being coloured, and what its community is.
			t.bcol = beacon_tint(e.brole, t.fcomm)

			-- faction_icons: on STATE cards (no role glyph there) and on work cards,
			-- where WHO is hiring beats the generic briefcase (the header already says
			-- it's work; the glyph stays as the fallback when no emblem exists). The
			-- emblem carries its own colours, so it's drawn untinted; and it stays a
			-- full text card (never an icon-only chip, which would hide the NPC's name).
			if C.faction_icons and (not ricon or e.role == "work") and t.fcomm then
				local ftex = FACTION_TEX[t.fcomm]
				if ftex then t.icon = ftex; t.icon_tinted = false; t.chip = false end
			end
		end
	end
	-- Drop the pool's object references. The entries outlive the pass now, and a game
	-- object held in one would keep it reachable from Lua for the two seconds until the
	-- next pass overwrote the slot -- which is precisely the kind of stale handle that
	-- outlives the NPC it points at. The tables themselves stay; only the references go.
	for i = 1, #_order do _order[i].obj = nil end
end

-- Take the card dialog the first time the HUD is available. get_hud() returns nil at
-- on_game_start (the HUD isn't built yet), so this is driven lazily from the update
-- loop; iqm_cards builds it, because a constructor belongs beside its class, and this
-- file keeps the handle because the render path uses it several times a frame.
local function ensure_cards()
	if CARDS then return true end
	CARDS = iqm_cards.ensure()
	return CARDS ~= nil
end

local function actor_on_update()
	if not ensure_cards() then return end
	local tg = time_global()
	-- advance the amortized NPC scans a slice at a time (spread over frames so the
	-- walk never lands as a periodic hitch). A pass completing brings the merge below
	-- forward to the NEXT frame, so a fresh set still shows up promptly (one frame is
	-- ~16 ms against a 2 s throttle) instead of waiting out the rest of the window.
	--
	-- The NEXT frame, not this one, which is what `+ 1` buys over the `0` this used to
	-- set. The two most expensive things the mod does are the scanner's final slice and
	-- the merge (collect_desired, the rank, the re-decorate); forcing the merge onto the
	-- publishing frame guaranteed the two largest bursts landed together, on a fixed
	-- ~2 s beat -- several times the median frame's cost from this mod, recurring, which
	-- is the shape that reads in play as periodic micro-stutter. Nothing reads the
	-- desired set but the merge, and the scanner publishes by swapping a completed table
	-- into `live` and only starts building the next one an interval later, so the set
	-- the merge finds one frame on is the same set, byte for byte.
	-- NOTHING IS SCANNED OR MERGED WHILE THE OVERLAY IS HIDDEN. render() has always
	-- applied this gate, but it applied it LAST, so with the fullscreen PDA up, the
	-- inventory open or an NPC dialog running the mod still advanced both amortized
	-- scanners at full budget every frame and still rebuilt and re-ranked the whole
	-- desired set twice a second -- and then threw every bit of it away at the gate.
	-- For reveal_mode 3 (hold-to-show) that is most frames of the session.
	--
	-- PAUSED, NOT TORN DOWN, and that is the whole design. clear_all() would make the
	-- saving free and the cost visible: `tracked`, the smoothing state and both
	-- scanners' mid-pass cursors all survive, so closing the PDA puts the identical
	-- cards back on the very next frame with no rescan, no replayed entrance and no
	-- second chirp -- the same promise render's own gate has always kept, extended
	-- back over the work that feeds it.
	--
	-- WHAT A PAUSED SET IS VISIBLE TO, since a stalled `tracked` is not private while
	-- this holds. iqm_nav is the only module that reads anything derived from it
	-- (route_goal -> route_target), and it stops publishing on the same gate one tick
	-- later, so its answer is discarded exactly as ours is; the SELECTED task's target,
	-- which is what the route follows whenever there is one, comes from
	-- active_task_target and never touches `tracked` at all -- so choosing a different
	-- task in the PDA is still picked up on the frame the PDA closes. Everything else
	-- crossing the seam (config, ranges, npc_on_screen, goal_pos, active_task_target)
	-- is either static or asks the world directly.
	--
	-- The taskwork probe rides the same gate rather than being left running: its queue
	-- feeds `work` cards and nothing else, and left alone it would see scan_idle() true
	-- on every hidden frame and probe HARDER while nothing is drawn.
	--
	-- render() is still called unconditionally below. It has to be: the combat-dim ease
	-- lives at the top of it, above every early return, and must keep running on hidden
	-- frames or SUP.f freezes at whatever the dim was when the PDA opened and SUP.t goes
	-- minutes stale (see the note there).
	local vis = overlay_visible(tg)
	if C.enabled and vis then
		if scan_tick(tg) then next_scan = tg + 1 end
		-- cold task-probes prefer frames where neither scanner is mid-pass (so the
		-- budgeted costs don't stack), but the module fires an overdue probe on a
		-- busy frame anyway: a hard idle-frames-only rule starves the queue when
		-- db.storage is large enough that scan passes tile the frames.
		if tw_tick then
			tw_tick(tg, scan_idle())
		end
	end
	-- next_scan is NOT re-armed while hidden, so however long the PDA was up the merge
	-- is simply overdue and runs on the first visible frame -- before render, so that
	-- frame draws a set that is at worst one scan interval old rather than a set that is
	-- one interval old AND a frame late.
	if vis and tg >= next_scan then
		next_scan = tg + SCAN_INTERVAL
		update()
	end
	render(tg)
end

-- --------------------------------------------------------------------------
-- MCM live-apply + startup (on_mcm_load lives in iqm_mcm.script)
-- --------------------------------------------------------------------------
function on_option_change()
	read_config()
	-- Re-arm the toggle: switching modes or rebinding the key while toggled off would
	-- otherwise leave the cards hidden with no obvious way back.
	reveal_on = true
	-- Independently of clear_all's own reset below: `enabled` and `mark_targets` gate
	-- route_target outright, so turning either on has to take effect on the next frame
	-- rather than at the end of a throttle window the player cannot see.
	route_goal_reset()
	clear_all()
	if CARDS then CARDS:invalidate_beacons() end
	next_scan = 0
	iqm_beacon.wp_repoll()             -- re-poll the placed waypoint at once (its switch may have just changed)
	scan_reset()                       -- rescan from scratch so toggles apply without the throttle lag
	if iqm_taskwork and iqm_taskwork.reset then iqm_taskwork.reset() end
end

-- --------------------------------------------------------------------------
-- Combat dim: the five engine triggers
-- --------------------------------------------------------------------------
-- Fields on SUP rather than file locals, so the whole feature costs one name (see SUP).
-- Every one is a stamp and nothing else -- no work, no allocation, and no reading of the
-- world -- because two of them fire on the shooting path: actor_on_weapon_fired comes
-- from CWeaponMagazined::OnShot and so arrives ONCE PER ROUND, which is what makes
-- full-auto re-stamp continuously and the dim decay from the last bullet for free.
--
-- All five are declared by axr_main and dispatched by bind_stalker_ext. They are present
-- in GAMMA's WINNING copy of axr_main (the 420- Tactical Compass override, not vanilla),
-- which is the copy that matters -- but SendScriptCallback simply drops a name nothing
-- declared, so on a pack without one of them that trigger no-ops instead of erroring.
--
-- Aiming is a state and takes no deadline: the engine calls OnZoomOut on holster
-- (Weapon.cpp:1279), on a slot change (Actor.cpp:2540) and on reload (Weapon.cpp:1823),
-- and CWeaponMagazined::OnZoomOut early-returns unless it really was zoomed -- so the
-- flag cannot be left stuck true by putting the gun away mid-aim.
function SUP.on_zoom_in()  SUP.ads = true  end
function SUP.on_zoom_out() SUP.ads = false end

-- (obj, wpn, ammo_elapsed, grenade_elapsed, ammo_type, grenade_type) -- all ignored.
function SUP.on_fired()
	if SUP.ms > 0 then SUP.till = time_global() + SUP.ms end
end

-- (wpn) for the jam, (wpn, ammo_total) for the reload. Both are the moment the animation
-- sweeps the weapon up into the middle of the screen, which is the overlap this is for.
function SUP.on_busy()
	if SUP.ms > 0 then SUP.till = time_global() + SUP.ms end
end

-- (shit, bone_id, flags) -- _g.script's CActor__OnBeforeHit sends the SHit FIRST, whatever
-- axr_main's parameter comment says. SUP.HIT is the filter that keeps radiation and burn
-- ticks from pinning the dim on; see its note.
function SUP.on_hit(shit)
	if SUP.ms > 0 and shit and SUP.HIT[shit.type] then SUP.till = time_global() + SUP.ms end
end

function on_game_start()
	get_obj      = level.object_by_id            -- bind the hot object lookup as an upvalue (level.* is ready now)
	char_comm    = character_community           -- per tracked NPC in update()
	-- iqm_scan's entry points. Bound here rather than at file scope: that module reads
	-- this one back, and only one of a mutually-referencing pair can safely look at
	-- the other while the files are still loading. By on_game_start both are whole.
	scan_desired, scan_tick, scan_idle, scan_reset =
		iqm_scan.desired_set, iqm_scan.tick, iqm_scan.idle, iqm_scan.reset
	scan_marker = iqm_scan.marker_set
	hire_price_of, slot_order_cmp, ROLE_PRIO =
		iqm_scan.hire_price_of, iqm_scan.order_cmp, iqm_scan.role_prio
	-- ...and the stage test that decides whether the selected task's marker is on a
	-- report-back or on a job still to do. Soft: without it active_task_target reports
	-- every selection as a hand-in, which is the pre-R2.47 behaviour rather than a break.
	scan_talk_to = iqm_scan.talk_to
	-- ...and the mutant/bounty classifier. Soft in the same way: nil leaves every task
	-- wearing the ordinary reticle, which is the pre-R2.48 behaviour.
	scan_task_kind = iqm_scan.task_kind
	-- ...iqm_cards' per-frame resolution watch, and iqm_beacon's whole surface. Same
	-- rule: bound here, never at file scope.
	cards_kx_tick, cards_kx = iqm_cards.kx_tick, iqm_cards.kx
	noise_tick, NZ = iqm_noise.tick, iqm_noise.state()
	beacon_offer, draw_beacons, hide_beacons =
		iqm_beacon.beacon_offer, iqm_beacon.draw_beacons, iqm_beacon.hide_beacons
	waypoint_goal, offer_waypoint = iqm_beacon.waypoint_goal, iqm_beacon.offer_waypoint
	task_goal, offer_task         = iqm_beacon.task_goal, iqm_beacon.offer_task
	offer_party                   = iqm_beacon.offer_party
	beacon_roles, BEACON_ICON, BEACON_RGB =
		iqm_beacon.roles(), iqm_beacon.beacon_icon, iqm_beacon.beacon_rgb
	hud_shown_fn = main_hud_shown or function() return true end  -- base _g.script; fallback binds the guard once instead of per frame
	axr          = axr_main or {}                -- holds the live binoc/scope zoom flags
	key_state_fn = key_state                     -- engine live key poll, for the hold-to-show mode
	mcm_keybinds = (ui_mcm and ui_mcm.key_hold) and true or false
	if iqm_taskwork then                         -- work detection (soft: absent module just means no work cards)
		tw_tick, tw_kind = iqm_taskwork.probe_tick, iqm_taskwork.work_kind
	end
	read_config()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_press", on_key_press)   -- reveal_mode 0/1 (press, double-tap)
	RegisterScriptCallback("on_key_hold", on_key_hold)     -- reveal_mode 2 (long press)
	-- The cached route goal is level-relative in both halves -- goal_pos drops a target on
	-- another level, and a cached position belongs to the level it was read on -- so the
	-- transition drops it rather than letting the ~200 ms window carry it across.
	-- iqm_nav does the same with its own state (iqm_nav.script:2153).
	RegisterScriptCallback("on_level_changing", route_goal_reset)
	RegisterScriptCallback("actor_on_first_update", route_goal_reset)
	-- Combat dim. Registered unconditionally rather than behind dim_hold > 0: the option
	-- changes at runtime, the handlers cost a compare when it is off, and a register /
	-- unregister pair driven from on_option_change is a second state machine to get wrong.
	RegisterScriptCallback("actor_on_weapon_zoom_in",  SUP.on_zoom_in)
	RegisterScriptCallback("actor_on_weapon_zoom_out", SUP.on_zoom_out)
	RegisterScriptCallback("actor_on_weapon_fired",    SUP.on_fired)
	RegisterScriptCallback("actor_on_weapon_reload",   SUP.on_busy)
	RegisterScriptCallback("actor_on_weapon_jammed",   SUP.on_busy)
	RegisterScriptCallback("actor_on_before_hit",      SUP.on_hit)
end
